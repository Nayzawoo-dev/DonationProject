@{
    ViewData["Title"] = "အသိပေးချက်များ — Danation";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="mb-1"><i class="bi bi-bell me-2"></i>အသိပေးချက်များ</h1>
                <p class="mb-0 opacity-75">သင်၏ မကြာသေးမီက အခြေအနေများနှင့် Campaign လှုပ်ရှားမှုများ</p>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-light btn-sm" id="markAllReadBtn">
                    <i class="bi bi-check-all me-1"></i>အားလုံး ဖတ်ပြီးမှတ်မည်
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container py-4" style="max-width:760px;">
    <div id="notifContainer">
        <!-- Skeleton loading -->
        @for (int i = 0; i < 5; i++)
        {
            <div class="card mb-2 notif-skeleton shadow-sm border-0" style="opacity:.6;">
                <div class="card-body d-flex gap-3 align-items-start py-3">
                    <div style="width:40px;height:40px;border-radius:50%;background:var(--border);flex-shrink:0;"></div>
                    <div class="flex-grow-1">
                        <div style="height:14px;background:var(--border);border-radius:4px;width:40%;margin-bottom:8px;"></div>
                        <div style="height:12px;background:var(--border);border-radius:4px;width:75%;"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="notifEmpty" class="empty-state d-none">
        <i class="bi bi-bell-slash"></i>
        <h4>အသိပေးချက် မရှိသေးပါ</h4>
        <p>အသိပေးချက်အားလုံး ဖတ်ရှုပြီးပါပြီ။ လှုပ်ရှားမှုအသစ်များရှိပါက ဤနေရာတွင် ပေါ်လာပါမည်။</p>
    </div>

    <!-- Load More -->
    <div class="text-center mt-4" id="loadMoreContainer" style="display:none!important;">
        <button class="btn btn-outline-primary btn-sm px-4" id="loadMoreBtn">
            <i class="bi bi-arrow-down-circle me-1"></i>ထပ်မံကြည့်ရှုမည်
        </button>
    </div>
</div>

@section Scripts {
    <script>
        var _page = 1;
        var _isLoading = false;

        function renderNotification(n) {
            var iconClass = 'bi-bell';
            var iconBg = 'var(--primary-light)';
            var iconColor = 'var(--primary)';
            var title = n.title || '';
            if (title.includes('Approved') || title.includes('approved') || title.includes('အတည်ပြု') || title.includes('✅')) {
                iconClass = 'bi-check-circle-fill'; iconBg = '#d1fae5'; iconColor = '#065f46';
            } else if (title.includes('Rejected') || title.includes('rejected') || title.includes('ငြင်းပယ်')) {
                iconClass = 'bi-x-circle-fill'; iconBg = '#fef2f2'; iconColor = '#991b1b';
            } else if (title.includes('Completed') || title.includes('ပြီးမြောက်') || title.includes('🏆')) {
                iconClass = 'bi-trophy-fill'; iconBg = '#fef9c3'; iconColor = '#854d0e';
            } else if (title.includes('Closed') || title.includes('ပိတ်သိမ်း') || title.includes('Goal') || title.includes('ပန်းတိုင်')) {
                iconClass = 'bi-flag-fill'; iconBg = '#eff6ff'; iconColor = '#1d4ed8';
            } else if (title.includes('Donation') || title.includes('လှူဒါန်း')) {
                iconClass = 'bi-heart-fill'; iconBg = '#fce7f3'; iconColor = '#9d174d';
            }

            return '<div class="card mb-2 notif-item shadow-sm border-0 ' + (!n.isRead ? 'border-start border-primary' : '') + '" data-id="' + n.id + '" style="border-left-width:3px!important;">' +
                '<div class="card-body d-flex gap-3 align-items-start py-3 ' + (!n.isRead ? 'bg-light-blue' : '') + '">' +
                '<div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width:40px;height:40px;background:' + iconBg + ';">' +
                '<i class="bi ' + iconClass + '" style="color:' + iconColor + ';font-size:1.1rem;"></i>' +
                '</div>' +
                '<div class="flex-grow-1 min-w-0">' +
                '<div class="d-flex justify-content-between align-items-start gap-2">' +
                '<strong class="small">' + Danation.escHtml(n.title) + '</strong>' +
                '<span class="text-muted flex-shrink-0" style="font-size:11px;white-space:nowrap;">' + Danation.escHtml(n.relativeTime) + '</span>' +
                '</div>' +
                '<p class="mb-0 small text-muted mt-1">' + Danation.escHtml(n.message) + '</p>' +
                (!n.isRead ? '<span class="badge bg-primary mt-1" style="font-size:.65rem;border-radius:50px;padding:.25em .65em;">အသစ်</span>' : '') +
                '</div>' +
                '</div>' +
                '</div>';
        }

        function loadNotifications() {
            if (_isLoading) return;
            _isLoading = true;

            $.get('/Notification/Latest?page=' + _page, function (res) {
                $('.notif-skeleton').remove();
                if (!res.success || !res.data || res.data.length === 0) {
                    if (_page === 1) {
                        $('#notifEmpty').removeClass('d-none');
                    } else {
                        $('#loadMoreContainer').hide();
                    }
                    return;
                }

                var html = '';
                $.each(res.data, function (i, n) { html += renderNotification(n); });
                $('#notifContainer').append(html);

                if (res.data.length >= 10) {
                    $('#loadMoreContainer').show().css('display', 'block');
                } else {
                    $('#loadMoreContainer').hide();
                }
            }).fail(function () {
                $('.notif-skeleton').remove();
                $('#notifContainer').html('<div class="alert alert-danger border-0 text-center">အသိပေးချက်များ ရယူ၍မရပါ။ စာမျက်နှာကို ပြန်လည်ဖွင့်ပေးပါ။</div>');
            }).always(function () {
                _isLoading = false;
            });
        }

        // Load more
        $('#loadMoreBtn').on('click', function () {
            _page++;
            loadNotifications();
        });

        // Mark all read
        $('#markAllReadBtn').on('click', function () {
            var btn = $(this).prop('disabled', true);
            Danation.post('/Notification/MarkAllRead', {},
                function () {
                    $('.notif-item').removeClass('border-start border-primary').find('.bg-light-blue').removeClass('bg-light-blue');
                    $('.notif-item .badge.bg-primary').remove();
                    Notiflix.Notify.success('အသိပေးချက်အားလုံးကို ဖတ်ပြီးအဖြစ် မှတ်သားပြီးပါပြီ။');
                    btn.prop('disabled', false);
                },
                function () {
                    btn.prop('disabled', false);
                }
            );
        });

        // Mark single item read on click
        $(document).on('click', '.notif-item', function () {
            var item = $(this);
            var id = item.data('id');
            if (!item.hasClass('border-primary')) return; // Already read

            Danation.post('/Notification/MarkRead/' + id, {}, function () {
                item.removeClass('border-start border-primary').find('.bg-light-blue').removeClass('bg-light-blue');
                item.find('.badge.bg-primary').fadeOut(200, function () { $(this).remove(); });
            });
        });

        // Load on page ready
        loadNotifications();

        // Real-time: Prepend new notification when received
        $(document).on('receiveNotification', function (e, n) {
            $('#notifEmpty').addClass('d-none');
            var html = renderNotification(n);
            var $newEl = $(html).hide();
            $('#notifContainer').prepend($newEl);
            $newEl.slideDown(300);
        });

        $(document).on('notificationReadUpdated', function (e, data) {
            if (data.allRead) {
                $('.notif-item').removeClass('border-start border-primary').find('.bg-light-blue').removeClass('bg-light-blue');
                $('.notif-item .badge.bg-primary').remove();
            } else if (data.notificationId) {
                var item = $('.notif-item[data-id="' + data.notificationId + '"]');
                item.removeClass('border-start border-primary').find('.bg-light-blue').removeClass('bg-light-blue');
                item.find('.badge.bg-primary').remove();
            }
        });
    </script>
}
