@{
    ViewData["Title"] = "မူလစာမျက်နှာ — Danation ပရဟိတ Platform";
    Layout = "_Layout";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <div class="hero-badge">
                    <i class="bi bi-heart-fill text-danger"></i>ဖေးမကြည်ဖြူ လက်တွဲကူ
                </div>
                <h1 class="hero-title">ပရဟိတတို့အလှူ</h1>
                <p class="hero-subtitle">
                    အနယ်နယ်အရပ်ရပ်မှ ပရဟိတ Campaign များကို အချိန်နဲ့တပြေးညီ ဆောင်ရွက်ပေးပြီး
                    အချင်းချင်း ကူညီဆောင်ရွက်ခြင်းအားဖြင့် ဖေးမကြည်ဖြူ ရိုင်းပင်းကြပါစို့။
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Campaign" asp-action="Index" class="btn btn-warning btn-xl fw-bold">
                        <i class="bi bi-grid-3x3-gap me-2"></i>Campaign များ ကြည့်ရှုမည်
                    </a>
                    @if (!User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-xl">
                            <i class="bi bi-person-plus me-2"></i>အကောင့်ဖွင့်ရန်
                        </a>
                    }
                    else if (!User.IsInRole("ADMIN"))
                    {
                        <a asp-controller="Campaign" asp-action="Create" class="btn btn-outline-light btn-xl">
                            <i class="bi bi-plus-circle me-2"></i>Campaign ဖွင့်မည်
                        </a>
                    }
                </div>
            </div>
            @if (User.IsInRole("ADMIN"))
            {
                <div class="col-lg-6 d-none d-lg-block">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="hero-stat-card" style="background:rgba(255,255,255,.12);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.2);">
                                <div class="fs-1 mb-1">💝</div>
                                <div class="fw-bold fs-3 text-white">@ViewBag.TotalCampaigns</div>
                                <div class="text-white-50 small">Campaign အားလုံး</div>
                            </div>
                        </div>
                        <div class="col-6 mt-4">
                            <div class="hero-stat-card" style="background:rgba(255,255,255,.12);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.2);">
                                <div class="fs-1 mb-1">🎯</div>
                                <div class="fw-bold fs-3 text-white">@ViewBag.OpenCampaigns</div>
                                <div class="text-white-50 small">ဖွင့်လှစ်နေသော</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="hero-stat-card" style="background:rgba(255,255,255,.12);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.2);">
                                <div class="fs-1 mb-1">✅</div>
                                <div class="fw-bold fs-3 text-white">@ViewBag.CompletedCampaigns</div>
                                <div class="text-white-50 small">ပြီးမြောက်ပြီး</div>
                            </div>
                        </div>
                        <div class="col-6 mt-4">
                            <div class="hero-stat-card" style="background:rgba(255,255,255,.12);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.2);">
                                <div class="fs-1 mb-1">👥</div>
                                <div class="fw-bold fs-3 text-white">@ViewBag.TotalUsers</div>
                                <div class="text-white-50 small">အသုံးပြုသူများ</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Recent Campaigns -->
@if (ViewBag.RecentCampaigns != null)
{
    var campaigns = (List<CampaignListItemViewModel>)ViewBag.RecentCampaigns;
    if (campaigns.Count > 0)
    {
        <section class="py-5 bg-white">
            <div class="container">
                <div class="section-header">
                    <h2>လက်ရှိ Campaign များ</h2>
                    <div class="section-divider"></div>
                    <p>ဤပရဟိတ Campaign များကို ယနေ့ ကူညီပံ့ပိုးပါ</p>
                </div>
                <div class="row g-4">
                    @foreach (var c in campaigns)
                    {
                        <div class="col-md-6 col-lg-4">
                            <a href="@Url.Action("Detail", "Campaign", new { id = c.Id })" class="text-decoration-none">
                                <div class="card campaign-card h-100">
                                    @if (!string.IsNullOrEmpty(c.ThumbnailImage))
                                    {
                                        <img src="@c.ThumbnailImage" class="card-img-top" alt="@c.Title" style="height:200px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="campaign-card card-img-placeholder">
                                            <i class="bi bi-heart-fill text-success" style="font-size:3rem;opacity:.4;"></i>
                                        </div>
                                    }
                                    <div class="card-body d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge badge-open">ဖွင့်လှစ်နေသည်</span>
                                        </div>
                                        <h5 class="card-title fw-bold">@c.Title</h5>
                                        <p class="card-text text-muted flex-grow-1">@(c.Description.Length > 100 ? c.Description[..100] + "…" : c.Description)</p>
                                        <div class="mt-3">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span class="fw-semibold text-success">@c.RaisedAmount.ToString("N0") MMK</span>
                                                <span class="text-muted">@c.ProgressPercent%</span>
                                            </div>
                                            <div class="progress">
                                                <div class="progress-bar @(c.ProgressPercent >= 100 ? "goal-reached" : "")"
                                                     style="width:@c.ProgressPercent%"></div>
                                            </div>
                                            <div class="text-muted small mt-1">ပန်းတိုင်: @c.GoalAmount.ToString("N0") MMK</div>
                                        </div>
                                        <div class="d-flex align-items-center mt-3 pt-3 border-top">
                                            @if (!string.IsNullOrEmpty(c.OwnerProfileImage))
                                            {
                                                <img src="@c.OwnerProfileImage" class="rounded-circle me-2" width="26" height="26" style="object-fit:cover;" alt="" />
                                            }
                                            else
                                            {
                                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center me-2"
                                                      style="width:26px;height:26px;background:linear-gradient(135deg,#2e7d32,#388e3c);">
                                                    <i class="bi bi-person-fill text-white" style="font-size:12px;"></i>
                                                </span>
                                            }
                                            <span class="text-muted small">@c.OwnerName</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
                <div class="text-center mt-5">
                    <a asp-controller="Campaign" asp-action="Index" class="btn btn-primary btn-lg px-5">
                        Campaign အားလုံး ကြည့်ရှုမည် <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </section>
    }
}

<!-- How It Works -->
<section class="py-5" style="background:var(--bg-light);">
    <div class="container">
        <div class="section-header">
            <h2>မည်သို့ အသုံးပြုမည်နည်း</h2>
            <div class="section-divider"></div>
            <p>ရိုးရှင်းသော၊ ပွင့်လင်းမြင်သာသော၊ လုံခြုံသော နည်းလမ်း</p>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="p-3 p-md-4">
                    <div class="step-circle mb-3" style="background:#e8f5e9;">
                        <i class="bi bi-person-plus-fill text-success fs-3"></i>
                    </div>
                    <h5 class="fw-bold">၁။ စာရင်းသွင်းပါ</h5>
                    <p class="text-muted small">Email ဖြင့် အကောင့်ဖွင့်ပြီး စတင်ပါ။</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 p-md-4">
                    <div class="step-circle mb-3" style="background:#f1f8e9;">
                        <i class="bi bi-megaphone-fill text-success fs-3"></i>
                    </div>
                    <h5 class="fw-bold">၂။ Campaign ဖွင့်ပါ</h5>
                    <p class="text-muted small">ပန်းတိုင်၊ အကြောင်းအရာ နှင့် သက်သေခံချက်များ ထည့်သွင်းပါ။</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 p-md-4">
                    <div class="step-circle mb-3" style="background:#fff8e1;">
                        <i class="bi bi-cash-stack text-warning fs-3"></i>
                    </div>
                    <h5 class="fw-bold">၃။ လှူဒါန်းပါ</h5>
                    <p class="text-muted small">KPay/WavePay ဖြင့် လွှဲပြောင်းပြီး Screenshot တင်ပါ။</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 p-md-4">
                    <div class="step-circle mb-3" style="background:#fce4ec;">
                        <i class="bi bi-check-circle-fill text-danger fs-3"></i>
                    </div>
                    <h5 class="fw-bold">၄။ သက်ရောက်မှု</h5>
                    <p class="text-muted small">Admin က လှူဒါန်းမှု အတည်ပြုပြီး Campaign ပြီးမြောက်ကြောင်း မှတ်တမ်းတင်သည်။</p>
                </div>
            </div>
        </div>
    </div>
</section>
