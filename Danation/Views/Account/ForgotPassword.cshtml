@{
    ViewData["Title"] = "စကားဝှက် မေ့သွားပါက — Danation";
    Layout = "_Layout";
}

<div class="auth-wrapper">
    <div class="container">
        <div class="auth-card" style="max-width:480px;">

            <!-- Step indicator -->
            <div class="d-flex justify-content-center mb-4" id="stepIndicator">
                <div class="step-dot active" id="dot1"></div>
                <div class="step-line" id="line12"></div>
                <div class="step-dot" id="dot2"></div>
                <div class="step-line" id="line23"></div>
                <div class="step-dot" id="dot3"></div>
            </div>

            <!-- Step 1: Enter Email -->
            <div id="step1">
                <div class="text-center mb-4">
                    <div class="auth-logo mb-3">
                        <span class="logo-icon"><i class="bi bi-lock"></i></span>Danation
                    </div>
                    <h4 class="fw-bold mb-1">စကားဝှက် မေ့သွားသလား?</h4>
                    <p class="text-muted small">သင့် Email လိပ်စာ ထည့်ပါ၊ အတည်ပြုကုဒ် ပို့ပေးပါမည်။</p>
                </div>
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" for="emailInput">Email လိပ်စာ</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                        <input type="email" id="emailInput" class="form-control border-start-0 ps-0"
                               placeholder="you@example.com" required autocomplete="email" />
                    </div>
                </div>
                <button class="btn btn-primary w-100 py-2" id="sendOtpBtn">
                    <i class="bi bi-send me-2"></i>အတည်ပြုကုဒ် ပို့မည်
                </button>
                <div class="text-center mt-3">
                    <a asp-controller="Account" asp-action="Login" class="text-muted small">
                        <i class="bi bi-arrow-left me-1"></i>အကောင့်ဝင်ရန်သို့ ပြန်သွားမည်
                    </a>
                </div>
            </div>

            <!-- Step 2: Enter OTP -->
            <div id="step2" class="d-none">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width:64px;height:64px;background:#e8f5e9;">
                        <i class="bi bi-envelope-check text-success fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Email စစ်ဆေးပါ</h4>
                    <p class="text-muted small" id="step2EmailMsg">ဂဏန်း ၆ လုံးပါ ကုဒ်တစ်ခု သင့် Email သို့ ပို့ထားပြီးပါပြီ။</p>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="otpInput">အတည်ပြုကုဒ်</label>
                    <input type="text" id="otpInput" class="form-control text-center fw-bold"
                           placeholder="000000" maxlength="6" inputmode="numeric"
                           style="font-size:1.8rem;letter-spacing:.4em;" />
                </div>
                <button class="btn btn-primary w-100 py-2" id="verifyOtpBtn">
                    <i class="bi bi-check-circle me-2"></i>ကုဒ် အတည်ပြုမည်
                </button>
                <div class="text-center mt-3">
                    <button type="button" id="resendOtpBtn" class="btn btn-link btn-sm text-muted p-0" style="text-decoration:none;">
                        ကုဒ်မရောက်ဘူးလား? <span class="text-success fw-semibold">ကုဒ် ထပ်ပို့မည်</span>
                    </button>
                </div>
            </div>

            <!-- Step 3: New Password -->
            <div id="step3" class="d-none">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width:64px;height:64px;background:#fff3e0;">
                        <i class="bi bi-shield-lock text-warning fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-1">စကားဝှက် အသစ် သတ်မှတ်ပါ</h4>
                    <p class="text-muted small">သင့်အကောင့်အတွက် လုံခြုံစိတ်ချရသော စကားဝှက်အသစ် သတ်မှတ်ပါ။</p>
                </div>
                <input type="hidden" id="resetTokenInput" />
                <div class="mb-3">
                    <label class="form-label" for="newPasswordInput">စကားဝှက် အသစ်</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
                        <input type="password" id="newPasswordInput" class="form-control border-start-0 ps-0"
                               placeholder="အနည်းဆုံး စာလုံး ၆ လုံး" minlength="6" required />
                        <button class="btn btn-outline-secondary border-start-0" type="button" id="toggleNewPwd">
                            <i class="bi bi-eye" id="eyeNew"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="confirmPasswordInput">စကားဝှက် အသစ် အတည်ပြုမည်</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock-fill text-muted"></i></span>
                        <input type="password" id="confirmPasswordInput" class="form-control border-start-0 ps-0"
                               placeholder="စကားဝှက်အသစ်ကို ထပ်မံရိုက်ထည့်ပါ" required />
                        <button class="btn btn-outline-secondary border-start-0" type="button" id="toggleConfirmPwd">
                            <i class="bi bi-eye" id="eyeConfirm"></i>
                        </button>
                    </div>
                </div>
                <button class="btn btn-success w-100 py-2" id="resetPasswordBtn">
                    <i class="bi bi-shield-check me-2"></i>စကားဝှက် အသစ် သတ်မှတ်မည်
                </button>
            </div>

            <!-- Step 4: Success -->
            <div id="step4" class="d-none text-center py-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width:80px;height:80px;background:#d1fae5;">
                    <i class="bi bi-check-circle-fill text-success" style="font-size:2.5rem;"></i>
                </div>
                <h4 class="fw-bold mb-2">စကားဝှက် ပြောင်းလဲပြီးပါပြီ!</h4>
                <p class="text-muted small mb-4">စကားဝှက် အသစ် ပြောင်းလဲပြီးပါပြီ။ ဝင်ရောက်ရန် စာမျက်နှာသို့ ပြန်လည်ပို့ဆောင်နေပါသည်…</p>
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            </div>
        </div>
    </div>
</div>

<style>
    .step-dot {
        width: 28px; height: 28px;
        border-radius: 50%;
        background: var(--border);
        border: 2px solid var(--border);
        transition: var(--transition);
        flex-shrink: 0;
    }
    .step-dot.active {
        background: var(--primary);
        border-color: var(--primary);
    }
    .step-dot.done {
        background: var(--success);
        border-color: var(--success);
    }
    .step-line {
        height: 2px;
        width: 60px;
        background: var(--border);
        align-self: center;
        transition: var(--transition);
    }
    .step-line.done { background: var(--success); }
    #stepIndicator { gap: 0; align-items: center; }
</style>

@section Scripts {
    <script>
        var _email = '';
        var _resetToken = '';
        var _csrfToken = $('input[name="__RequestVerificationToken"]').val();

        function goToStep(n) {
            ['step1','step2','step3','step4'].forEach(function(s, i) {
                $('#' + s).addClass('d-none');
                var dotId = 'dot' + (i + 1);
                if (i + 1 < n) {
                    $('#' + dotId).removeClass('active').addClass('done');
                } else if (i + 1 === n) {
                    $('#' + dotId).addClass('active').removeClass('done');
                } else {
                    $('#' + dotId).removeClass('active done');
                }
            });
            $('#step' + n).removeClass('d-none');
            ['line12','line23'].forEach(function(l, i) {
                if (i + 2 <= n) $('#' + l).addClass('done');
                else $('#' + l).removeClass('done');
            });
        }

        // Step 1: Send OTP
        $('#sendOtpBtn').on('click', function () {
            _email = $('#emailInput').val().trim();
            if (!_email || !_email.includes('@@')) {
                Notiflix.Notify.warning('မှန်ကန်သော Email လိပ်စာ ထည့်သွင်းပေးပါ။');
                return;
            }
            var btn = $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>ပို့နေပါသည်…');
            $.post('/Account/SendResetOtp',
                { email: _email, __RequestVerificationToken: _csrfToken },
                function (res) {
                    $('#step2EmailMsg').text('ဂဏန်း ၆ လုံးပါ ကုဒ်ကို ' + _email + ' သို့ ပို့ပေးထားပါသည်။ Inbox သို့မဟုတ် Spam folder တွင် စစ်ဆေးပါ။');
                    goToStep(2);
                    Notiflix.Notify.info('အတည်ပြုကုဒ် ပို့ပြီးပါပြီ!');
                }
            ).fail(function () {
                Notiflix.Notify.failure('ကုဒ်ပို့ခြင်း မအောင်မြင်ပါ။ ထပ်မံကြိုးစားပေးပါ။');
            }).always(function () {
                btn.prop('disabled', false).html('<i class="bi bi-send me-2"></i>အတည်ပြုကုဒ် ပို့မည်');
            });
        });
        
        // Step 2: Verify OTP
        $('#verifyOtpBtn').on('click', function () {
            var otp = $('#otpInput').val().trim();
            if (otp.length !== 6 || !/^\d{6}$/.test(otp)) {
                Notiflix.Notify.warning('Email သို့ ပို့ထားသော ဂဏန်း ၆ လုံးပါ ကုဒ်ကို ရိုက်ထည့်ပါ။');
                return;
            }
            var btn = $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>စစ်ဆေးနေပါသည်…');
            $.post('/Account/VerifyResetOtp',
                { email: _email, otpCode: otp, __RequestVerificationToken: _csrfToken },
                function (res) {
                    if (res.success) {
                        _resetToken = res.resetToken;
                        $('#resetTokenInput').val(_resetToken);
                        goToStep(3);
                    } else {
                        Notiflix.Notify.failure(res.message || 'အတည်ပြုကုဒ် မှားယွင်းနေပါသည်။ ထပ်မံစစ်ဆေးပေးပါ။');
                        btn.prop('disabled', false).html('<i class="bi bi-check-circle me-2"></i>ကုဒ် အတည်ပြုမည်');
                    }
                }
            ).fail(function () {
                Notiflix.Notify.failure('အတည်ပြုခြင်း မအောင်မြင်ပါ။ ထပ်မံကြိုးစားပေးပါ။');
                btn.prop('disabled', false).html('<i class="bi bi-check-circle me-2"></i>ကုဒ် အတည်ပြုမည်');
            });
        });

        // Resend OTP
        $('#resendOtpBtn').on('click', function () {
            var btn = $(this);
            btn.prop('disabled', true);
            $.post('/Account/SendResetOtp',
                { email: _email, __RequestVerificationToken: _csrfToken },
                function (res) {
                    Notiflix.Notify.success('အတည်ပြုကုဒ်အသစ် ပို့ပြီးပါပြီ!');
                    $('#otpInput').val('');
                }
            ).fail(function () {
                Notiflix.Notify.failure('ကုဒ် ထပ်ပို့ခြင်း မအောင်မြင်ပါ။');
            }).always(function () {
                setTimeout(function () { btn.prop('disabled', false); }, 5000);
            });
        });

        // Allow Enter key to advance steps
        $('#emailInput').on('keypress', function (e) { if (e.which === 13) $('#sendOtpBtn').click(); });
        $('#otpInput').on('keypress', function (e) { if (e.which === 13) $('#verifyOtpBtn').click(); });

        // Auto-advance on OTP input fill
        $('#otpInput').on('input', function () {
            if ($(this).val().length === 6) $('#verifyOtpBtn').click();
        });

        // Step 3: Reset Password
        $('#resetPasswordBtn').on('click', function () {
            var newPwd = $('#newPasswordInput').val();
            var confirmPwd = $('#confirmPasswordInput').val();
            if (newPwd.length < 6) { Notiflix.Notify.warning('စကားဝှက်သည် အနည်းဆုံး စာလုံး ၆ လုံး ရှိရပါမည်။'); return; }
            if (newPwd !== confirmPwd) { Notiflix.Notify.warning('စကားဝှက် နှစ်ကြိမ် ရိုက်ထည့်မှု မတူညီပါ။'); return; }
            var btn = $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>ပြောင်းလဲနေပါသည်…');
            $.post('/Account/ResetPassword', {
                Email: _email,
                ResetToken: _resetToken,
                NewPassword: newPwd,
                ConfirmPassword: confirmPwd,
                __RequestVerificationToken: _csrfToken
            }, function (res) {
                if (res.success) {
                    goToStep(4);
                    setTimeout(function () { window.location.href = res.redirectUrl || '/Account/Login'; }, 2500);
                } else {
                    Notiflix.Notify.failure(res.message || 'စကားဝှက် ပြောင်းလဲခြင်း မအောင်မြင်ပါ။ အစမှ ပြန်လည်ပြုလုပ်ပေးပါ။');
                    btn.prop('disabled', false).html('<i class="bi bi-shield-check me-2"></i>စကားဝှက် အသစ် သတ်မှတ်မည်');
                }
            }).fail(function () {
                Notiflix.Notify.failure('လုပ်ဆောင်ချက် မအောင်မြင်ပါ။ ထပ်မံကြိုးစားပေးပါ။');
                btn.prop('disabled', false).html('<i class="bi bi-shield-check me-2"></i>စကားဝှက် အသစ် သတ်မှတ်မည်');
            });
        });

        // Toggle password visibility
        $('#toggleNewPwd').on('click', function () {
            var inp = $('#newPasswordInput');
            var isHidden = inp.attr('type') === 'password';
            inp.attr('type', isHidden ? 'text' : 'password');
            $('#eyeNew').toggleClass('bi-eye bi-eye-slash');
        });
        $('#toggleConfirmPwd').on('click', function () {
            var inp = $('#confirmPasswordInput');
            var isHidden = inp.attr('type') === 'password';
            inp.attr('type', isHidden ? 'text' : 'password');
            $('#eyeConfirm').toggleClass('bi-eye bi-eye-slash');
        });
    </script>
}
