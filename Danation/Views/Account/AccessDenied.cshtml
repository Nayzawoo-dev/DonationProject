@{
    ViewData["Title"] = "ဝင်ရောက်ခွင့်မရှိပါ — Danation";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="py-5" style="max-width:560px;margin:0 auto;">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4"
             style="width:100px;height:100px;background:#fee2e2;">
            <i class="bi bi-shield-x-fill text-danger" style="font-size:3rem;"></i>
        </div>
        <h1 class="fw-bold mb-3">ဝင်ရောက်ခွင့် မရှိပါ</h1>
        <p class="text-muted mb-4 fs-5" style="line-height:1.8;">
            ဤစာမျက်နှာကို ဝင်ရောက်ကြည့်ရှုရန် လိုအပ်သော ခွင့်ပြုချက် မရှိသေးပါ သို့မဟုတ် သင့်အကောင့်တွင် လုပ်ပိုင်ခွင့် မရှိပါ။
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                <i class="bi bi-house me-2"></i>ပင်မစာမျက်နှာသို့
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary px-4 py-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>အကောင့်ဝင်ရောက်ရန်
            </a>
        </div>
    </div>
</div>
