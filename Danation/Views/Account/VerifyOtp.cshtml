@model VerifyOtpViewModel
@{
    ViewData["Title"] = "Email အတည်ပြုချက် — Danation";
    Layout = "_Layout";
}

<div class="auth-wrapper">
    <div class="container">
        <div class="auth-card animate-fadeInUp text-center" style="max-width:480px;margin:0 auto;">
            <!-- Icon -->
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width:80px;height:80px;background:#e8f5e9;">
                    <i class="bi bi-envelope-check-fill fs-1 text-success"></i>
                </div>
                <h2 class="fw-bold mb-2">Email စစ်ဆေးပါ</h2>
                <p class="text-muted small">
                    ဂဏန်း ၆ လုံးပါ OTP ကုဒ်ကို သင့် Email <strong class="text-success">@Model.Email</strong> သို့ ပို့ပေးထားပါသည်။<br />
                    အကောင့် အတည်ပြုရန် အောက်ပါအကွက်တွင် ရိုက်ထည့်ပါ။
                </p>
            </div>

            <!-- Error from TempData -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 text-start mb-3 d-none" id="validationSummary"></div>

            <form id="verifyOtpForm" asp-action="VerifyOtp" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />

                <!-- OTP Input -->
                <div class="mb-4">
                    <label asp-for="OtpCode" class="form-label fw-semibold">OTP ကုဒ် ထည့်ပါ</label>
                    <input asp-for="OtpCode" id="otpInput"
                           class="form-control text-center fw-bold"
                           style="font-size:2rem;letter-spacing:14px;max-width:260px;margin:0 auto;"
                           maxlength="6" placeholder="______"
                           autocomplete="one-time-code"
                           inputmode="numeric"
                           pattern="[0-9]{6}" />
                    <span asp-validation-for="OtpCode" class="text-danger small d-block mt-1"></span>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn btn-primary w-100 py-2 mb-4" id="verifyOtpBtn">
                    <i class="bi bi-shield-check me-2"></i>Email အတည်ပြုမည်
                </button>
            </form>

            <!-- Resend OTP -->
            <div class="border-top pt-3">
                <p class="text-muted small mb-2">ကုဒ် မရောက်ဘူးလား?</p>
                <button type="button" id="resendBtn" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-arrow-repeat me-1"></i>OTP ကုဒ် ထပ်ပို့မည်
                </button>
                <div id="resendTimer" class="text-muted small mt-2 d-none">
                    <span id="timerCount">60</span> စက္ကန့် စောင့်ဆိုင်းပေးပါ။
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Account" asp-action="Register" class="text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>အကောင့်ဖွင့်ခြင်းသို့ ပြန်သွားမည်
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // OTP digits only
        $('#otpInput').on('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
            if (this.value.length === 6) {
                $('#verifyOtpForm').submit();
            }
        });

        // AJAX Form Submit
        $('#verifyOtpForm').on('submit', function (e) {
            e.preventDefault();
            var form = $(this);
            var btn = $('#verifyOtpBtn');
            var summary = $('#validationSummary');

            summary.addClass('d-none').empty();

            var otp = $('#otpInput').val().trim();
            if (otp.length !== 6) {
                Notiflix.Notify.warning('ဂဏန်း ၆ လုံးပါ OTP ကုဒ် ထည့်ပါ။');
                return;
            }

            if (btn.prop('disabled')) return;
            btn.prop('disabled', true);

            Danation.post('/Account/VerifyOtp', form.serialize(),
                function (res) {
                    Notiflix.Notify.success(res.message || 'Email အောင်မြင်စွာ အတည်ပြုပြီးပါပြီ!');
                    var target = res.redirectUrl || '/Account/Login';
                    setTimeout(function () { window.location.href = target; }, 1000);
                },
                function (err) {
                    btn.prop('disabled', false);
                    var msg = (err && err.message) ? err.message : 'OTP ကုဒ် မှားယွင်းနေပါသည် သို့မဟုတ် သက်တမ်းကုန်ဆုံးသွားပါပြီ။';
                    summary.removeClass('d-none').html('<i class="bi bi-exclamation-triangle-fill me-2"></i>' + Danation.escHtml(msg));
                }
            );
        });

        // Resend OTP
        var resendCooldown = false;
        $('#resendBtn').on('click', function () {
            if (resendCooldown) return;
            var email = '@Model.Email';
            var token = $('input[name="__RequestVerificationToken"]').val();

            Notiflix.Loading.pulse('OTP ကုဒ် ပို့နေပါသည်...');
            $.ajax({
                url: '/Account/ResendOtp',
                type: 'POST',
                data: { email: email, __RequestVerificationToken: token },
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).done(function (res) {
                Notiflix.Loading.remove();
                if (res.success) {
                    Notiflix.Notify.success(res.message || 'OTP ကုဒ်အသစ် ပို့ပြီးပါပြီ။');
                    startResendTimer();
                } else {
                    Notiflix.Notify.failure(res.message || 'OTP ကုဒ် ထပ်ပို့ခြင်း မအောင်မြင်ပါ။');
                }
            }).fail(function () {
                Notiflix.Loading.remove();
                Notiflix.Notify.failure('OTP ကုဒ် မပို့နိုင်ပါ။ ထပ်မံကြိုးစားပေးပါ။');
            });
        });

        function startResendTimer() {
            resendCooldown = true;
            $('#resendBtn').prop('disabled', true);
            $('#resendTimer').removeClass('d-none');
            var count = 60;
            $('#timerCount').text(count);
            var t = setInterval(function () {
                count--;
                $('#timerCount').text(count);
                if (count <= 0) {
                    clearInterval(t);
                    resendCooldown = false;
                    $('#resendBtn').prop('disabled', false);
                    $('#resendTimer').addClass('d-none');
                }
            }, 1000);
        }
    </script>
}
