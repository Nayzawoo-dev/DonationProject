@model List<AdminCampaignSummaryViewModel>
@{
    ViewData["Title"] = "Manage Campaigns — Admin";
    Layout = "_Layout";
    var statusFilter = ViewBag.StatusFilter as string;
    var search = ViewBag.Search as string;
}

<div class="admin-page-header">
    <div class="container">
        <h1 class="mb-1"><i class="bi bi-megaphone me-2"></i>Manage Campaigns</h1>
        <p class="mb-0 opacity-75">Review, approve, reject, and close campaigns</p>
    </div>
</div>

@await Html.PartialAsync("FlashMessage");

<div class="container py-4">
    <!-- Filters Form -->
    <form id="adminCampaignFilterForm" method="get" asp-action="Campaigns" asp-controller="Admin" class="row g-2 mb-4">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" id="adminCampaignSearch" value="@search" class="form-control border-start-0 ps-0"
                       placeholder="Search title or owner…" autocomplete="off" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" id="adminCampaignStatus" class="form-select">
                <option value="">All Statuses</option>
                @{
                    string[] adminStatuses = { "PENDING", "OPEN", "GOAL_REACHED", "CLOSED", "COMPLETED", "REJECTED" };
                    string[] adminLabels  = { "Pending", "Open", "Goal Reached", "Closed", "Completed", "Rejected" };
                    for (int si = 0; si < adminStatuses.Length; si++)
                    {
                        if (statusFilter == adminStatuses[si])
                        {
                            <option value="@adminStatuses[si]" selected="selected">@adminLabels[si]</option>
                        }
                        else
                        {
                            <option value="@adminStatuses[si]">@adminLabels[si]</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Search</button>
        </div>
        <div class="col-md-2">
            <button type="button" id="clearAdminCampaignsBtn" class="btn btn-outline-secondary w-100 @(string.IsNullOrEmpty(search) && string.IsNullOrEmpty(statusFilter) ? "d-none" : "")">
                Clear
            </button>
        </div>
    </form>

    <div class="card p-0 overflow-hidden" id="adminCampaignsTableContainer">
        <partial name="_AdminCampaignTablePartial" model="Model" />
    </div>
</div>

<!-- Extend End Date Modal -->
<div class="modal fade" id="extendModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-plus me-2 text-primary"></i>Extend Campaign End Date</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3" id="extendModalTitle"></p>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">New End Date & Time</label>
                    <input type="datetime-local" id="extendNewEndDate" class="form-control" />
                    <div class="form-text">Must be a future date later than the start date.</div>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="extendReopenCheck" checked>
                    <label class="form-check-label small" for="extendReopenCheck">
                        Reopen campaign for donations if it is currently closed/expired
                    </label>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmExtendBtn">
                    <i class="bi bi-calendar-check me-1"></i>Confirm Extension
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Reason Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-x-circle me-2 text-danger"></i>Reject Campaign</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Provide a reason for rejection. The campaign owner will be notified.</p>
                <textarea id="rejectReason" class="form-control" rows="4"
                          placeholder="Enter rejection reason…" maxlength="1000"></textarea>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmRejectBtn">
                    <i class="bi bi-x-circle me-1"></i>Reject Campaign
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var rejectingId = null;
        var extendingId = null;
        var adminSearchTimer = null;

        function fetchAdminCampaigns() {
            var form = $('#adminCampaignFilterForm');
            var url = '/Admin/Campaigns?' + form.serialize();

            Danation.loadPartial(url, '#adminCampaignsTableContainer', function () {
                var hasVal = $('#adminCampaignSearch').val() || $('#adminCampaignStatus').val();
                if (hasVal) {
                    $('#clearAdminCampaignsBtn').removeClass('d-none');
                } else {
                    $('#clearAdminCampaignsBtn').addClass('d-none');
                }
            });
        }

        // Live status change
        $('#adminCampaignStatus').on('change', function () {
            fetchAdminCampaigns();
        });

        // Search live debounce
        $('#adminCampaignSearch').on('input', function () {
            clearTimeout(adminSearchTimer);
            adminSearchTimer = setTimeout(fetchAdminCampaigns, 400);
        });

        // Form submit
        $('#adminCampaignFilterForm').on('submit', function (e) {
            e.preventDefault();
            fetchAdminCampaigns();
        });

        // Clear filters
        $('#clearAdminCampaignsBtn').on('click', function () {
            $('#adminCampaignSearch').val('');
            $('#adminCampaignStatus').val('');
            fetchAdminCampaigns();
        });

        // Approve
        $(document).on('click', '.approve-btn', function () {
            var id = $(this).data('id');
            var row = $(this).closest('tr');
            Danation.confirmPost('Approve this campaign? It will go OPEN for donations.', '/Admin/ApproveCampaign',
                { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Reject — open modal
        $(document).on('click', '.reject-btn', function () {
            rejectingId = $(this).data('id');
            $('#rejectReason').val('');
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        });

        $('#confirmRejectBtn').on('click', function () {
            var reason = $('#rejectReason').val().trim();
            if (!reason) { Notiflix.Notify.warning('Please enter a rejection reason.'); return; }
            bootstrap.Modal.getInstance(document.getElementById('rejectModal')).hide();
            Danation.post('/Admin/RejectCampaign', { id: rejectingId, reason: reason },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Extend End Date — open modal
        $(document).on('click', '.extend-btn', function () {
            extendingId = $(this).data('id');
            var title = $(this).data('title');
            var currentEnd = $(this).data('enddate');
            $('#extendModalTitle').text('Campaign: ' + title);
            $('#extendNewEndDate').val(currentEnd || '');
            new bootstrap.Modal(document.getElementById('extendModal')).show();
        });

        $('#confirmExtendBtn').on('click', function () {
            var newEndDate = $('#extendNewEndDate').val();
            if (!newEndDate) {
                Notiflix.Notify.warning('Please select a new end date and time.');
                return;
            }
            var reopen = $('#extendReopenCheck').is(':checked');
            bootstrap.Modal.getInstance(document.getElementById('extendModal')).hide();

            Danation.post('/Admin/ExtendCampaignDate',
                { id: extendingId, newEndDate: newEndDate, reopen: reopen },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Reopen campaign
        $(document).on('click', '.reopen-btn', function () {
            var id = $(this).data('id');
            var title = $(this).data('title');
            var isExpired = $(this).data('is-expired') === true || $(this).data('is-expired') === 'true';
            var currentEnd = $(this).data('enddate');

            if (isExpired) {
                extendingId = id;
                $('#extendModalTitle').text('Reopen Expired Campaign: ' + title);
                $('#extendNewEndDate').val(currentEnd || '');
                $('#extendReopenCheck').prop('checked', true);
                new bootstrap.Modal(document.getElementById('extendModal')).show();
                Notiflix.Notify.info('This campaign has expired. Please select a new future end date to reopen.');
                return;
            }

            Danation.confirmPost('Reopen "' + title + '" for donations?', '/Admin/ReopenCampaign',
                { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Close
        $(document).on('click', '.close-btn', function () {
            var id = $(this).data('id');
            var row = $(this).closest('tr');
            Danation.confirmPost('Close this campaign? It will no longer accept donations.', '/Admin/CloseCampaign',
                { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Real-time: Campaign status change from other sessions/admins
        $(document).on('campaignStatusChanged', function (e, data) {
            var row = $('#campaignsTable tr[data-id="' + data.campaignId + '"]');
            if (row.length) {
                var badgeMap = {
                    'OPEN': 'badge-open',
                    'GOAL_REACHED': 'badge-goal',
                    'CLOSED': 'badge-closed',
                    'COMPLETED': 'badge-completed',
                    'REJECTED': 'badge-rejected',
                    'PENDING': 'badge-pending'
                };
                var cls = badgeMap[data.status] || 'bg-secondary';
                row.find('.status-badge').attr('class', 'badge ' + cls + ' status-badge').text(data.status.replace('_', ' '));

                if (data.status === 'OPEN' || data.status === 'REJECTED') {
                    row.find('.approve-btn, .reject-btn').remove();
                } else if (data.status === 'CLOSED') {
                    row.find('.close-btn').replaceWith(
                        '<a href="/Admin/CreateCompletion/' + data.campaignId + '" class="btn btn-sm btn-primary" title="Create Completion"><i class="bi bi-trophy"></i></a>'
                    );
                } else if (data.status === 'COMPLETED') {
                    row.find('a[title="Create Completion"]').remove();
                }
            }
        });

        $(document).on('campaignCreated', function (e, data) {
            var currentStatus = $('#adminCampaignStatus').val();
            if (!currentStatus || currentStatus === 'PENDING') {
                fetchAdminCampaigns();
            }
        });
    </script>
}
