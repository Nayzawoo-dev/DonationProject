@model List<AdminCampaignSummaryViewModel>
@{
    ViewData["Title"] = "Manage Campaigns — Admin";
    Layout = "_Layout";
    var statusFilter = ViewBag.StatusFilter as string;
    var search = ViewBag.Search as string;
}

<div class="admin-page-header">
    <div class="container">
        <h1 class="mb-1"><i class="bi bi-megaphone me-2"></i>Manage Campaigns</h1>
        <p class="mb-0 opacity-75">Review, approve, reject, and close campaigns</p>
    </div>
</div>

<div class="container py-4">
    <!-- Filters -->
    <form method="get" asp-action="Campaigns" asp-controller="Admin" class="row g-2 mb-4">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-start-0 ps-0"
                       placeholder="Search title or owner…" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @{
                    string[] adminStatuses = { "PENDING", "OPEN", "GOAL_REACHED", "CLOSED", "COMPLETED", "REJECTED" };
                    string[] adminLabels  = { "Pending", "Open", "Goal Reached", "Closed", "Completed", "Rejected" };
                    for (int si = 0; si < adminStatuses.Length; si++)
                    {
                        if (statusFilter == adminStatuses[si])
                        {
                            <option value="@adminStatuses[si]" selected="selected">@adminLabels[si]</option>
                        }
                        else
                        {
                            <option value="@adminStatuses[si]">@adminLabels[si]</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Search</button>
        </div>
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(statusFilter))
        {
            <div class="col-md-2">
                <a asp-action="Campaigns" asp-controller="Admin" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        }
    </form>

    <div class="card p-0 overflow-hidden">
        <table class="table table-hover mb-0" id="campaignsTable">
            <thead>
                <tr>
                    <th>Campaign</th>
                    <th>Owner</th>
                    <th>Goal</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Files</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No campaigns found.</td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    var statusClass = c.Status switch
                    {
                        "OPEN" => "badge-open",
                        "GOAL_REACHED" => "badge-goal",
                        "CLOSED" => "badge-closed",
                        "COMPLETED" => "badge-completed",
                        "REJECTED" => "badge-rejected",
                        _ => "badge-pending"
                    };
                    <tr data-id="@c.Id">
                        <td>
                            <div class="fw-semibold" style="max-width:200px;">
                                <a asp-controller="Admin" asp-action="CampaignDetail" asp-route-id="@c.Id"
                                   class="text-dark text-decoration-none">@c.Title</a>
                            </div>
                        </td>
                        <td class="small text-muted">@c.OwnerName<br /><span class="text-muted">@@@c.OwnerUsername</span></td>
                        <td class="small">@c.GoalAmount.ToString("N0") MMK</td>
                        <td><span class="badge @statusClass status-badge">@c.Status.Replace("_", " ")</span></td>
                        <td class="small text-muted">@c.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td class="small">
                            <span title="Images"><i class="bi bi-images me-1"></i>@c.ImageCount</span>
                            <span class="ms-2" title="Docs"><i class="bi bi-file-earmark me-1"></i>@c.DocumentCount</span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1 flex-wrap">
                                <a asp-controller="Admin" asp-action="CampaignDetail" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-outline-secondary" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (c.Status == "PENDING")
                                {
                                    <button class="btn btn-sm btn-success approve-btn" data-id="@c.Id" title="Approve">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger reject-btn" data-id="@c.Id" title="Reject">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                @if (c.Status == "GOAL_REACHED")
                                {
                                    <button class="btn btn-sm btn-warning close-btn" data-id="@c.Id" title="Close Campaign">
                                        <i class="bi bi-lock"></i>
                                    </button>
                                }
                                @if (c.Status == "CLOSED")
                                {
                                    <a asp-controller="Admin" asp-action="CreateCompletion" asp-route-id="@c.Id"
                                       class="btn btn-sm btn-primary" title="Create Completion">
                                        <i class="bi bi-trophy"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Reject Reason Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-x-circle me-2 text-danger"></i>Reject Campaign</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Provide a reason for rejection. The campaign owner will be notified.</p>
                <textarea id="rejectReason" class="form-control" rows="4"
                          placeholder="Enter rejection reason…" maxlength="1000"></textarea>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmRejectBtn">
                    <i class="bi bi-x-circle me-1"></i>Reject Campaign
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var rejectingId = null;

        // Approve
        $(document).on('click', '.approve-btn', function () {
            var id = $(this).data('id');
            var row = $(this).closest('tr');
            Danation.confirmPost('Approve this campaign? It will go OPEN for donations.', '/Admin/ApproveCampaign',
                { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    row.find('.status-badge').attr('class', 'badge badge-open status-badge').text('OPEN');
                    row.find('.approve-btn, .reject-btn').remove();
                }
            );
        });

        // Reject — open modal
        $(document).on('click', '.reject-btn', function () {
            rejectingId = $(this).data('id');
            $('#rejectReason').val('');
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        });

        $('#confirmRejectBtn').on('click', function () {
            var reason = $('#rejectReason').val().trim();
            if (!reason) { Notiflix.Notify.warning('Please enter a rejection reason.'); return; }
            var row = $('tr[data-id="' + rejectingId + '"]');
            bootstrap.Modal.getInstance(document.getElementById('rejectModal')).hide();
            Danation.post('/Admin/RejectCampaign', { id: rejectingId, reason: reason },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    row.find('.status-badge').attr('class', 'badge badge-rejected status-badge').text('REJECTED');
                    row.find('.approve-btn, .reject-btn').remove();
                }
            );
        });

        // Close
        $(document).on('click', '.close-btn', function () {
            var id = $(this).data('id');
            var row = $(this).closest('tr');
            Danation.confirmPost('Close this campaign? It will no longer accept donations.', '/Admin/CloseCampaign',
                { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    row.find('.status-badge').attr('class', 'badge badge-closed status-badge').text('CLOSED');
                    row.find('.close-btn').replaceWith(
                        '<a href="/Admin/CreateCompletion/' + id + '" class="btn btn-sm btn-primary" title="Create Completion"><i class="bi bi-trophy"></i></a>'
                    );
                }
            );
        });
    </script>
}
