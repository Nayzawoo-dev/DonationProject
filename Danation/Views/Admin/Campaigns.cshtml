@model List<AdminCampaignSummaryViewModel>
@{
    ViewData["Title"] = "Campaign များ စီမံရန် — Admin";
    Layout = "_Layout";
    var statusFilter = ViewBag.StatusFilter as string;
    var search = ViewBag.Search as string;
}

<div class="admin-page-header">
    <div class="container">
        <h1 class="mb-1"><i class="bi bi-megaphone me-2"></i>Campaign များ စီမံရန်</h1>
        <p class="mb-0 opacity-75">Campaign များကို စိစစ်ခြင်း၊ အတည်ပြုခြင်း၊ ငြင်းပယ်ခြင်းနှင့် ပိတ်သိမ်းခြင်း</p>
    </div>
</div>

@await Html.PartialAsync("FlashMessage")

<div class="container py-4">
    <!-- Filters Form -->
    <form id="adminCampaignFilterForm" method="get" asp-action="Campaigns" asp-controller="Admin" class="row g-2 mb-4">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" id="adminCampaignSearch" value="@search" class="form-control border-start-0 ps-0"
                       placeholder="ခေါင်းစဉ် သို့မဟုတ် ဖန်တီးသူဖြင့် ရှာဖွေပါ…" autocomplete="off" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" id="adminCampaignStatus" class="form-select">
                <option value="">အခြေအနေ အားလုံး</option>
                @{
                    string[] adminStatuses = { "PENDING", "OPEN", "GOAL_REACHED", "CLOSED", "COMPLETED", "REJECTED" };
                    string[] adminLabels  = { "စိစစ်ဆဲ", "ဖွင့်လှစ်ဆဲ", "ပန်းတိုင်ပြည့်", "ပိတ်သိမ်း", "ပြီးမြောက်", "ငြင်းပယ်" };
                    for (int si = 0; si < adminStatuses.Length; si++)
                    {
                        if (statusFilter == adminStatuses[si])
                        {
                            <option value="@adminStatuses[si]" selected="selected">@adminLabels[si]</option>
                        }
                        else
                        {
                            <option value="@adminStatuses[si]">@adminLabels[si]</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>ရှာဖွေမည်</button>
        </div>
        <div class="col-md-2">
            <button type="button" id="clearAdminCampaignsBtn" class="btn btn-outline-secondary w-100 @(string.IsNullOrEmpty(search) && string.IsNullOrEmpty(statusFilter) ? "d-none" : "")">
                ရှင်းမည်
            </button>
        </div>
    </form>

    <div class="card p-0 overflow-hidden shadow-sm border-0" id="adminCampaignsTableContainer">
        <partial name="_AdminCampaignTablePartial" model="Model" />
    </div>
</div>

<!-- Extend End Date Modal -->
<div class="modal fade" id="extendModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-plus me-2 text-primary"></i>Campaign ပြီးဆုံးမည့်ရက် တိုးမြှင့်ခြင်း</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3" id="extendModalTitle"></p>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">ပြီးဆုံးမည့် ရက်စွဲနှင့် အချိန် အသစ်</label>
                    <input type="datetime-local" id="extendNewEndDate" class="form-control" />
                    <div class="form-text">စတင်သည့်ရက်စွဲထက် နောက်ကျသော အနာဂတ်ရက်စွဲ ဖြစ်ရပါမည်။</div>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="extendReopenCheck" checked>
                    <label class="form-check-label small" for="extendReopenCheck">
                        လက်ရှိတွင် ပိတ်သိမ်းထားပါက အလှူငွေများ ထပ်မံလက်ခံနိုင်စေရန် ပြန်လည်ဖွင့်လှစ်မည်
                    </label>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">မလုပ်တော့ပါ</button>
                <button type="button" class="btn btn-primary" id="confirmExtendBtn">
                    <i class="bi bi-calendar-check me-1"></i>ရက်တိုးမြှင့်ခြင်း အတည်ပြုမည်
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Reason Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-x-circle me-2 text-danger"></i>Campaign ငြင်းပယ်ခြင်း</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">ငြင်းပယ်ရသည့် အကြောင်းရင်းကို ရေးသားပါ။ Campaign ဖန်တီးသူထံ အသိပေးချက် ပို့ပေးပါမည်။</p>
                <textarea id="rejectReason" class="form-control" rows="4"
                          placeholder="ငြင်းပယ်ရသည့် အကြောင်းရင်း ရိုက်ထည့်ပါ…" maxlength="1000"></textarea>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">မလုပ်တော့ပါ</button>
                <button type="button" class="btn btn-danger" id="confirmRejectBtn">
                    <i class="bi bi-x-circle me-1"></i>Campaign ငြင်းပယ်မည်
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var rejectingId = null;
        var extendingId = null;
        var adminSearchTimer = null;

        function fetchAdminCampaigns() {
            var form = $('#adminCampaignFilterForm');
            var url = '/Admin/Campaigns?' + form.serialize();

            Danation.loadPartial(url, '#adminCampaignsTableContainer', function () {
                var hasVal = $('#adminCampaignSearch').val() || $('#adminCampaignStatus').val();
                if (hasVal) {
                    $('#clearAdminCampaignsBtn').removeClass('d-none');
                } else {
                    $('#clearAdminCampaignsBtn').addClass('d-none');
                }
            });
        }

        // Live status change
        $('#adminCampaignStatus').on('change', function () {
            fetchAdminCampaigns();
        });

        // Search live debounce
        $('#adminCampaignSearch').on('input', function () {
            clearTimeout(adminSearchTimer);
            adminSearchTimer = setTimeout(fetchAdminCampaigns, 400);
        });

        // Form submit
        $('#adminCampaignFilterForm').on('submit', function (e) {
            e.preventDefault();
            fetchAdminCampaigns();
        });

        // Clear filters
        $('#clearAdminCampaignsBtn').on('click', function () {
            $('#adminCampaignSearch').val('');
            $('#adminCampaignStatus').val('');
            fetchAdminCampaigns();
        });

        // Approve
        $(document).on('click', '.approve-btn', function () {
            var id = $(this).data('id');
            var row = $(this).closest('tr');
            Danation.confirmPost('ဤ Campaign ကို အတည်ပြုမည်လား? အလှူငွေများ လက်ခံနိုင်ရန် ဖွင့်လှစ်ပေးပါမည်။', '/Admin/ApproveCampaign',
                { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Reject — open modal
        $(document).on('click', '.reject-btn', function () {
            rejectingId = $(this).data('id');
            $('#rejectReason').val('');
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        });

        $('#confirmRejectBtn').on('click', function () {
            var reason = $('#rejectReason').val().trim();
            if (!reason) { Notiflix.Notify.warning('ငြင်းပယ်ရသည့် အကြောင်းရင်း ရိုက်ထည့်ပေးပါ။'); return; }
            bootstrap.Modal.getInstance(document.getElementById('rejectModal')).hide();
            Danation.post('/Admin/RejectCampaign', { id: rejectingId, reason: reason },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Extend End Date — open modal
        $(document).on('click', '.extend-btn', function () {
            extendingId = $(this).data('id');
            var title = $(this).data('title');
            var currentEnd = $(this).data('enddate');
            $('#extendModalTitle').text('Campaign: ' + title);
            $('#extendNewEndDate').val(currentEnd || '');
            new bootstrap.Modal(document.getElementById('extendModal')).show();
        });

        $('#confirmExtendBtn').on('click', function () {
            var newEndDate = $('#extendNewEndDate').val();
            if (!newEndDate) {
                Notiflix.Notify.warning('ပြီးဆုံးမည့် ရက်စွဲနှင့် အချိန် အသစ်ကို ရွေးချယ်ပေးပါ။');
                return;
            }
            var reopen = $('#extendReopenCheck').is(':checked');
            bootstrap.Modal.getInstance(document.getElementById('extendModal')).hide();

            Danation.post('/Admin/ExtendCampaignDate',
                { id: extendingId, newEndDate: newEndDate, reopen: reopen },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Reopen campaign
        $(document).on('click', '.reopen-btn', function () {
            var id = $(this).data('id');
            var title = $(this).data('title');
            var isExpired = $(this).data('is-expired') === true || $(this).data('is-expired') === 'true';
            var currentEnd = $(this).data('enddate');

            if (isExpired) {
                extendingId = id;
                $('#extendModalTitle').text('သက်တမ်းကုန် Campaign ပြန်ဖွင့်ခြင်း: ' + title);
                $('#extendNewEndDate').val(currentEnd || '');
                $('#extendReopenCheck').prop('checked', true);
                new bootstrap.Modal(document.getElementById('extendModal')).show();
                Notiflix.Notify.info('ဤ Campaign သည် သက်တမ်းကုန်ဆုံးသွားပါပြီ။ ပြန်လည်ဖွင့်လှစ်ရန် အနာဂတ် ရက်စွဲအသစ် ရွေးချယ်ပေးပါ။');
                return;
            }

            Danation.confirmPost('"' + title + '" အား အလှူငွေများ လက်ခံနိုင်ရန် ပြန်လည်ဖွင့်လှစ်မည်လား?', '/Admin/ReopenCampaign',
                { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Close
        $(document).on('click', '.close-btn', function () {
            var id = $(this).data('id');
            var row = $(this).closest('tr');
            Danation.confirmPost('ဤ Campaign ကို ပိတ်သိမ်းမည်လား? အလှူငွေများ ထပ်မံလက်ခံနိုင်တော့မည် မဟုတ်ပါ။', '/Admin/CloseCampaign',
                { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    fetchAdminCampaigns();
                }
            );
        });

        // Real-time: Campaign status change from other sessions/admins
        $(document).on('campaignStatusChanged', function (e, data) {
            var row = $('#campaignsTable tr[data-id="' + data.campaignId + '"]');
            if (row.length) {
                var badgeMap = {
                    'OPEN': 'badge-open',
                    'GOAL_REACHED': 'badge-goal',
                    'CLOSED': 'badge-closed',
                    'COMPLETED': 'badge-completed',
                    'REJECTED': 'badge-rejected',
                    'PENDING': 'badge-pending'
                };
                var textMap = {
                    'OPEN': 'ဖွင့်လှစ်ဆဲ',
                    'GOAL_REACHED': 'ပန်းတိုင်ပြည့်',
                    'CLOSED': 'ပိတ်သိမ်း',
                    'COMPLETED': 'ပြီးမြောက်',
                    'REJECTED': 'ငြင်းပယ်',
                    'PENDING': 'စိစစ်ဆဲ'
                };
                var cls = badgeMap[data.status] || 'bg-secondary';
                var text = (data.status === 'CLOSED' && data.closeReason === 'EXPIRED') ? 'သက်တမ်းကုန်' : (textMap[data.status] || data.status.replace('_', ' '));
                row.find('.status-badge').attr('class', 'badge ' + cls + ' status-badge').text(text);

                if (data.status === 'OPEN' || data.status === 'REJECTED') {
                    row.find('.approve-btn, .reject-btn').remove();
                } else if (data.status === 'CLOSED') {
                    row.find('.close-btn').replaceWith(
                        '<a href="/Admin/CreateCompletion/' + data.campaignId + '" class="btn btn-sm btn-primary" title="ပြီးမြောက်မှု မှတ်တမ်းတင်မည်"><i class="bi bi-trophy"></i></a>'
                    );
                } else if (data.status === 'COMPLETED') {
                    row.find('a[title="ပြီးမြောက်မှု မှတ်တမ်းတင်မည်"], a[title="Create Completion"]').remove();
                }
            }
        });

        $(document).on('campaignCreated', function (e, data) {
            var currentStatus = $('#adminCampaignStatus').val();
            if (!currentStatus || currentStatus === 'PENDING') {
                fetchAdminCampaigns();
            }
        });
    </script>
}
