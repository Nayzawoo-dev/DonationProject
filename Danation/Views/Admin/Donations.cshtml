@model List<AdminDonationSummaryViewModel>
@{
    ViewData["Title"] = "Manage Donations — Admin";
    Layout = "_Layout";
    var statusFilter = ViewBag.StatusFilter as string;
}

<div class="admin-page-header">
    <div class="container">
        <h1 class="mb-1"><i class="bi bi-cash-stack me-2"></i>Manage Donations</h1>
        <p class="mb-0 opacity-75">Verify and approve/reject donor payment transfers</p>
    </div>
</div>

<div class="container py-4">
    <!-- Filter Tabs -->
    <div class="d-flex gap-2 mb-4 flex-wrap" id="donationFilterTabs">
        <button type="button" data-status=""
           class="btn btn-sm don-filter-btn @(string.IsNullOrEmpty(statusFilter) ? "btn-primary" : "btn-outline-secondary")">All</button>
        <button type="button" data-status="PENDING"
           class="btn btn-sm don-filter-btn @(statusFilter == "PENDING" ? "btn-warning" : "btn-outline-secondary")">
            <i class="bi bi-clock me-1"></i>Pending
        </button>
        <button type="button" data-status="APPROVED"
           class="btn btn-sm don-filter-btn @(statusFilter == "APPROVED" ? "btn-success" : "btn-outline-secondary")">
            <i class="bi bi-check-circle me-1"></i>Approved
        </button>
        <button type="button" data-status="REJECTED"
           class="btn btn-sm don-filter-btn @(statusFilter == "REJECTED" ? "btn-danger" : "btn-outline-secondary")">
            <i class="bi bi-x-circle me-1"></i>Rejected
        </button>
    </div>

    <div class="card p-0 overflow-hidden" id="adminDonationsTableContainer">
        <partial name="_AdminDonationTablePartial" model="Model" />
    </div>
</div>

<!-- Screenshot Modal -->
<div class="modal fade" id="screenshotModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-image me-2"></i>Transfer Screenshot</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="screenshotImg" src="" class="img-fluid rounded-xl screenshot-preview" alt="" />
            </div>
        </div>
    </div>
</div>

<!-- Approve Donation Modal (enter verified amount) -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-check-circle me-2 text-success"></i>Approve Donation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Enter the actual verified transfer amount in MMK. This will be recorded as the official donation amount.
                </p>
                <label class="form-label">Verified Amount (MMK) <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light">MMK</span>
                    <input type="number" id="verifiedAmount" class="form-control" min="1" step="1"
                           placeholder="Enter the actual transferred amount" />
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmApproveBtn">
                    <i class="bi bi-check-circle me-1"></i>Approve
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Donation Modal -->
<div class="modal fade" id="rejectDonModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-x-circle me-2 text-danger"></i>Reject Donation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Provide a reason for rejection. The donor will be notified.</p>
                <textarea id="donRejectReason" class="form-control" rows="3"
                          placeholder="Reason for rejection…" maxlength="1000"></textarea>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDonRejectBtn">
                    <i class="bi bi-x-circle me-1"></i>Reject
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var approvingId = null, rejectingDonId = null;

        function openScreenshot(url) {
            document.getElementById('screenshotImg').src = url;
            new bootstrap.Modal(document.getElementById('screenshotModal')).show();
        }

        // Filter tabs click (AJAX)
        $('.don-filter-btn').on('click', function () {
            var btn = $(this);
            var status = btn.data('status');

            $('.don-filter-btn').removeClass('btn-primary btn-warning btn-success btn-danger').addClass('btn-outline-secondary');
            if (status === 'PENDING') btn.removeClass('btn-outline-secondary').addClass('btn-warning');
            else if (status === 'APPROVED') btn.removeClass('btn-outline-secondary').addClass('btn-success');
            else if (status === 'REJECTED') btn.removeClass('btn-outline-secondary').addClass('btn-danger');
            else btn.removeClass('btn-outline-secondary').addClass('btn-primary');

            var url = '/Admin/Donations' + (status ? '?status=' + status : '');
            Danation.loadPartial(url, '#adminDonationsTableContainer');
        });

        // Approve btn → show modal
        $(document).on('click', '.approve-don-btn', function () {
            approvingId = $(this).data('id');
            $('#verifiedAmount').val('');
            new bootstrap.Modal(document.getElementById('approveModal')).show();
        });

        $('#confirmApproveBtn').on('click', function () {
            var amount = parseFloat($('#verifiedAmount').val());
            if (!amount || amount <= 0) { Notiflix.Notify.warning('Please enter a valid amount.'); return; }
            var row = $('tr[data-id="' + approvingId + '"]');
            bootstrap.Modal.getInstance(document.getElementById('approveModal')).hide();
            Danation.post('/Admin/ApproveDonation', { id: approvingId, amount: amount },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    row.find('.don-status-badge').attr('class', 'badge badge-approved don-status-badge').text('APPROVED');
                    row.find('td:nth-child(4)').html('<span class="text-success fw-semibold small">' + parseFloat(amount).toLocaleString('en-US') + ' MMK</span>');
                    row.find('.approve-don-btn, .reject-don-btn').closest('div').html('<span class="text-muted small">Verified</span>');
                }
            );
        });

        // Reject btn → modal
        $(document).on('click', '.reject-don-btn', function () {
            rejectingDonId = $(this).data('id');
            $('#donRejectReason').val('');
            new bootstrap.Modal(document.getElementById('rejectDonModal')).show();
        });

        $('#confirmDonRejectBtn').on('click', function () {
            var reason = $('#donRejectReason').val().trim();
            if (!reason) { Notiflix.Notify.warning('Please enter a rejection reason.'); return; }
            var row = $('tr[data-id="' + rejectingDonId + '"]');
            bootstrap.Modal.getInstance(document.getElementById('rejectDonModal')).hide();
            Danation.post('/Admin/RejectDonation', { id: rejectingDonId, reason: reason },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    row.find('.don-status-badge').attr('class', 'badge badge-rejected don-status-badge').text('REJECTED');
                    row.find('.approve-don-btn, .reject-don-btn').closest('div').html('<span class="text-muted small">Rejected</span>');
                }
            );
        });
    </script>
}
