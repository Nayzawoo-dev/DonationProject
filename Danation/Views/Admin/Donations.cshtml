@model List<AdminDonationSummaryViewModel>
@{
    ViewData["Title"] = "အလှူငွေများ စီမံခန့်ခွဲခြင်း — Admin";
    Layout = "_Layout";
    var statusFilter = ViewBag.StatusFilter as string;
}

<div class="admin-page-header">
    <div class="container">
        <h1 class="mb-1"><i class="bi bi-cash-stack me-2"></i>အလှူငွေများ စီမံခန့်ခွဲခြင်း</h1>
        <p class="mb-0 opacity-75">အလှူရှင်များ၏ လွှဲငွေဖြတ်ပိုင်းများကို စိစစ်၍ အတည်ပြုခြင်း သို့မဟုတ် ငြင်းပယ်ခြင်း ပြုလုပ်နိုင်သည်</p>
    </div>
</div>


<div class="container py-4">
    <!-- Filter Tabs -->
    <div class="d-flex gap-2 mb-4 flex-wrap" id="donationFilterTabs">
        <button type="button" data-status=""
           class="btn btn-sm don-filter-btn @(string.IsNullOrEmpty(statusFilter) ? "btn-primary" : "btn-outline-secondary")">အားလုံး</button>
        <button type="button" data-status="PENDING"
           class="btn btn-sm don-filter-btn @(statusFilter == "PENDING" ? "btn-warning" : "btn-outline-secondary")">
            <i class="bi bi-clock me-1"></i>စိစစ်ဆဲ
        </button>
        <button type="button" data-status="APPROVED"
           class="btn btn-sm don-filter-btn @(statusFilter == "APPROVED" ? "btn-success" : "btn-outline-secondary")">
            <i class="bi bi-check-circle me-1"></i>အတည်ပြုပြီး
        </button>
        <button type="button" data-status="REJECTED"
           class="btn btn-sm don-filter-btn @(statusFilter == "REJECTED" ? "btn-danger" : "btn-outline-secondary")">
            <i class="bi bi-x-circle me-1"></i>ငြင်းပယ်ပြီး
        </button>
    </div>

    <div class="card p-0 overflow-hidden" id="adminDonationsTableContainer">
        <partial name="_AdminDonationTablePartial" model="Model" />
    </div>
</div>

<!-- Screenshot Modal -->
<div class="modal fade" id="screenshotModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-image me-2"></i>ငွေလွှဲဖြတ်ပိုင်း ဓာတ်ပုံ</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="screenshotImg" src="" class="img-fluid rounded-xl screenshot-preview" alt="" />
            </div>
        </div>
    </div>
</div>

<!-- Approve Donation Modal (enter verified amount) -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-check-circle me-2 text-success"></i>အလှူငွေ အတည်ပြုခြင်း</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    စိစစ်တွေ့ရှိရသော အမှန်တကယ် လွှဲပြောင်းငွေပမာဏ (ကျပ်) ကို ထည့်သွင်းပါ။ ဤပမာဏသည် တရားဝင် အလှူငွေအဖြစ် မှတ်တမ်းတင်သွားမည်ဖြစ်ပါသည်။
                </p>
                <label class="form-label">စိစစ်ပြီး အလှူငွေပမာဏ (ကျပ်) <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light">ကျပ်</span>
                    <input type="number" id="verifiedAmount" class="form-control" min="1" step="1"
                           placeholder="အမှန်တကယ် လွှဲပြောင်းထားသော ပမာဏ ထည့်ပါ" />
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">မလုပ်တော့ပါ</button>
                <button type="button" class="btn btn-success" id="confirmApproveBtn">
                    <i class="bi bi-check-circle me-1"></i>အတည်ပြုမည်
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Donation Modal -->
<div class="modal fade" id="rejectDonModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-x-circle me-2 text-danger"></i>အလှူငွေ ငြင်းပယ်ခြင်း</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">ငြင်းပယ်ရသည့် အကြောင်းရင်းကို ထည့်သွင်းပါ။ အလှူရှင်ထံ အသိပေးချက် ပို့ပါမည်။</p>
                <textarea id="donRejectReason" class="form-control" rows="3"
                          placeholder="ငြင်းပယ်ရသည့် အကြောင်းရင်း ရေးသားပါ..." maxlength="1000"></textarea>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">မလုပ်တော့ပါ</button>
                <button type="button" class="btn btn-danger" id="confirmDonRejectBtn">
                    <i class="bi bi-x-circle me-1"></i>ငြင်းပယ်မည်
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var approvingId = null, rejectingDonId = null;

        function openScreenshot(url) {
            document.getElementById('screenshotImg').src = url;
            new bootstrap.Modal(document.getElementById('screenshotModal')).show();
        }

        // Filter tabs click (AJAX)
        $('.don-filter-btn').on('click', function () {
            var btn = $(this);
            var status = btn.data('status');

            $('.don-filter-btn').removeClass('btn-primary btn-warning btn-success btn-danger').addClass('btn-outline-secondary');
            if (status === 'PENDING') btn.removeClass('btn-outline-secondary').addClass('btn-warning');
            else if (status === 'APPROVED') btn.removeClass('btn-outline-secondary').addClass('btn-success');
            else if (status === 'REJECTED') btn.removeClass('btn-outline-secondary').addClass('btn-danger');
            else btn.removeClass('btn-outline-secondary').addClass('btn-primary');

            var url = '/Admin/Donations' + (status ? '?status=' + status : '');
            Danation.loadPartial(url, '#adminDonationsTableContainer');
        });

        // Approve btn → show modal
        $(document).on('click', '.approve-don-btn', function () {
            approvingId = $(this).data('id');
            $('#verifiedAmount').val('');
            new bootstrap.Modal(document.getElementById('approveModal')).show();
        });

        $('#confirmApproveBtn').on('click', function () {
            var amount = parseFloat($('#verifiedAmount').val());
            if (!amount || amount <= 0) { Notiflix.Notify.warning('ကျေးဇူးပြု၍ တရားဝင်သော ပမာဏ ထည့်သွင်းပါ။'); return; }
            var row = $('tr[data-id="' + approvingId + '"]');
            bootstrap.Modal.getInstance(document.getElementById('approveModal')).hide();
            Danation.post('/Admin/ApproveDonation', { id: approvingId, amount: amount },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    row.find('.don-status-badge').attr('class', 'badge badge-approved don-status-badge').text('အတည်ပြုပြီး');
                    row.find('td:nth-child(4)').html('<span class="text-success fw-semibold small">' + parseFloat(amount).toLocaleString('en-US') + ' ကျပ်</span>');
                    row.find('.approve-don-btn, .reject-don-btn').closest('div').html('<span class="text-muted small">စိစစ်ပြီး</span>');
                }
            );
        });

        // Reject btn → modal
        $(document).on('click', '.reject-don-btn', function () {
            rejectingDonId = $(this).data('id');
            $('#donRejectReason').val('');
            new bootstrap.Modal(document.getElementById('rejectDonModal')).show();
        });

        $('#confirmDonRejectBtn').on('click', function () {
            var reason = $('#donRejectReason').val().trim();
            if (!reason) { Notiflix.Notify.warning('ကျေးဇူးပြု၍ ငြင်းပယ်ရသည့် အကြောင်းရင်း ထည့်သွင်းပါ။'); return; }
            var row = $('tr[data-id="' + rejectingDonId + '"]');
            bootstrap.Modal.getInstance(document.getElementById('rejectDonModal')).hide();
            Danation.post('/Admin/RejectDonation', { id: rejectingDonId, reason: reason },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    row.find('.don-status-badge').attr('class', 'badge badge-rejected don-status-badge').text('ငြင်းပယ်ပြီး');
                    row.find('.approve-don-btn, .reject-don-btn').closest('div').html('<span class="text-muted small">ငြင်းပယ်ပြီး</span>');
                }
            );
        });

        // Real-time: Donation created or updated from other admin/user
        $(document).on('donationCreated', function (e, data) {
            var activeBtn = $('.don-filter-btn.btn-warning, .don-filter-btn.btn-primary');
            var activeStatus = activeBtn.length ? activeBtn.data('status') : '';
            if (activeStatus === '' || activeStatus === 'PENDING') {
                var url = '/Admin/Donations' + (activeStatus ? '?status=' + activeStatus : '');
                Danation.loadPartial(url, '#adminDonationsTableContainer');
            }
        });

        $(document).on('donationStatusChanged', function (e, data) {
            var row = $('#donationsTable tr[data-id="' + data.donationId + '"]');
            if (row.length) {
                if (data.status === 'APPROVED') {
                    row.find('.don-status-badge').attr('class', 'badge badge-approved don-status-badge').text('အတည်ပြုပြီး');
                    if (data.amount) {
                        row.find('td:nth-child(4)').html('<span class="text-success fw-semibold small">' + parseFloat(data.amount).toLocaleString('en-US') + ' ကျပ်</span>');
                    }
                    row.find('.approve-don-btn, .reject-don-btn').closest('div').replaceWith('<span class="text-muted small">' + Danation.escHtml(data.verifiedByName || 'စိစစ်ပြီး') + '</span>');
                } else if (data.status === 'REJECTED') {
                    row.find('.don-status-badge').attr('class', 'badge badge-rejected don-status-badge').text('ငြင်းပယ်ပြီး');
                    row.find('.approve-don-btn, .reject-don-btn').closest('div').replaceWith('<span class="text-muted small">ငြင်းပယ်ပြီး</span>');
                }
            }
        });
    </script>
}
