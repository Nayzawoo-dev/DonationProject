@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard — Danation";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <div class="container">
        <h1 class="mb-1"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</h1>
        <p class="mb-0 opacity-75">Danation Platform ၏ အထွေထွေ ခြုံငုံသုံးသပ်ချက်နှင့် စီမံခန့်ခွဲမှု</p>
    </div>
</div>

<div class="container py-4">
    <!-- Stats Row 1 -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-blue">
                <div class="stat-icon"><i class="bi bi-people"></i></div>
                <div class="stat-value" id="statTotalUsers">@Model.TotalUsers</div>
                <div class="stat-label">အသုံးပြုသူ စုစုပေါင်း</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-purple">
                <div class="stat-icon"><i class="bi bi-megaphone"></i></div>
                <div class="stat-value" id="statTotalCampaigns">@Model.TotalCampaigns</div>
                <div class="stat-label">Campaign စုစုပေါင်း</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-orange">
                <div class="stat-icon"><i class="bi bi-clock"></i></div>
                <div class="stat-value" id="statPendingCampaigns">@Model.PendingCampaigns</div>
                <div class="stat-label">အတည်ပြုရန် ကျန် Campaign</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-green">
                <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
                <div class="stat-value" id="statOpenCampaigns">@Model.OpenCampaigns</div>
                <div class="stat-label">ဖွင့်လှစ်ဆဲ Campaign</div>
            </div>
        </div>
    </div>

    <!-- Stats Row 2 -->
    <div class="row g-3 mb-5">
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-cyan">
                <div class="stat-icon"><i class="bi bi-trophy"></i></div>
                <div class="stat-value" id="statGoalReachedCampaigns">@Model.GoalReachedCampaigns</div>
                <div class="stat-label">ပန်းတိုင်ပြည့် Campaign</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-teal">
                <div class="stat-icon"><i class="bi bi-star"></i></div>
                <div class="stat-value" id="statCompletedCampaigns">@Model.CompletedCampaigns</div>
                <div class="stat-label">ပြီးမြောက်သော Campaign</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-pink">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div class="stat-value" id="statPendingDonations">@Model.PendingDonations</div>
                <div class="stat-label">အတည်ပြုရန် ကျန် အလှူငွေ</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-green">
                <div class="stat-icon"><i class="bi bi-currency-exchange"></i></div>
                <div class="stat-value" id="statTotalApprovedAmount" style="font-size:1.4rem;">@Model.TotalApprovedAmount.ToString("N0")</div>
                <div class="stat-label">အတည်ပြုပြီး အလှူငွေ (ကျပ်)</div>
            </div>
        </div>
    </div>

    <!-- Surplus Fund Management Row -->
    <div class="row g-3 mb-5">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="stat-card" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                <div class="stat-icon" style="background: rgba(255,255,255,.2); color: white;"><i class="bi bi-gift-fill"></i></div>
                <div class="stat-value" id="statAvailableSurplus" style="font-size:1.6rem; color: white;">@Model.TotalAvailableSurplus.ToString("N0") MMK</div>
                <div class="stat-label" style="color: rgba(255,255,255,.85);">လက်ကျန် ပိုလျှံရန်ပုံငွေ (Surplus)</div>
                <div class="mt-3">
                    <a asp-controller="Admin" asp-action="AllocateSurplus" class="btn btn-sm btn-light fw-bold text-success">
                        <i class="bi bi-arrow-left-right me-1"></i>ပိုလျှံရန်ပုံငွေ ခွဲဝေမည်
                    </a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="stat-card" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white;">
                <div class="stat-icon" style="background: rgba(255,255,255,.2); color: white;"><i class="bi bi-send-check-fill"></i></div>
                <div class="stat-value" id="statSurplusAllocated" style="font-size:1.6rem; color: white;">@Model.TotalSurplusAllocated.ToString("N0") MMK</div>
                <div class="stat-label" style="color: rgba(255,255,255,.85);">ခွဲဝေပေးပြီး ပိုလျှံရန်ပုံငွေ</div>
                <div class="mt-3 small" style="color: rgba(255,255,255,.75);">
                    <i class="bi bi-shield-check me-1"></i>ဖွင့်လှစ်ဆဲ Campaign များသို့ ဖြည့်တင်းပြီး
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100 p-3 d-flex flex-column justify-content-center shadow-sm border-0" style="border: 1px dashed #6366f1!important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 text-primary fs-3" style="background: rgba(99, 102, 241, 0.1);">
                        <i class="bi bi-sliders"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">ပိုလျှံရန်ပုံငွေ စီမံခန့်ခွဲမှု</h6>
                        <p class="text-muted small mb-0">ပန်းတိုင်ကျော်လွန် ရရှိထားသော ရန်ပုံငွေများကို အခြားလိုအပ်နေသော Campaign များထံ ပြန်လည်ခွဲဝေပေးခြင်း။</p>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="Admin" asp-action="AllocateSurplus" class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-plus-circle me-1"></i>ရန်ပုံငွေ ခွဲဝေမှုအသစ် ပြုလုပ်မည်
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Pending Campaigns -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <span class="fw-bold"><i class="bi bi-megaphone me-2 text-primary"></i>စိစစ်ရန် ကျန်ရှိသော Campaign များ</span>
                    <a asp-controller="Admin" asp-action="Campaigns" asp-route-status="PENDING"
                       class="text-decoration-none small fw-semibold text-primary">အားလုံး ကြည့်မည်</a>
                </div>
                <div class="card-body p-0" id="recentPendingCampaignsContainer">
                    @if (Model.RecentPendingCampaigns.Count == 0)
                    {
                        <div class="p-4 text-center text-muted small">
                            <i class="bi bi-check-circle-fill text-success fs-4 d-block mb-2"></i>
                            စိစစ်ရန် Campaign မရှိပါ
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var c in Model.RecentPendingCampaigns)
                            {
                                <div class="list-group-item px-3 py-2">
                                    <div class="d-flex align-items-start gap-2">
                                        <div class="flex-grow-1 min-width-0">
                                            <div class="fw-semibold text-truncate">@c.Title</div>
                                            <div class="text-muted small">
                                                @c.OwnerName (@@@c.OwnerUsername) ·
                                                ပန်းတိုင်: @c.GoalAmount.ToString("N0") MMK ·
                                                <i class="bi bi-images me-1"></i>@c.ImageCount
                                                <i class="bi bi-file-earmark ms-1 me-1"></i>@c.DocumentCount
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <a asp-controller="Admin" asp-action="CampaignDetail" asp-route-id="@c.Id"
                                               class="btn btn-sm btn-outline-primary py-0 px-2">စိစစ်မည်</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Pending Donations -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <span class="fw-bold"><i class="bi bi-cash-stack me-2 text-success"></i>စိစစ်ရန် ကျန်ရှိသော အလှူငွေများ</span>
                    <a asp-controller="Admin" asp-action="Donations" asp-route-status="PENDING"
                       class="text-decoration-none small fw-semibold text-primary">အားလုံး ကြည့်မည်</a>
                </div>
                <div class="card-body p-0" id="recentPendingDonationsContainer">
                    @if (Model.RecentPendingDonations.Count == 0)
                    {
                        <div class="p-4 text-center text-muted small">
                            <i class="bi bi-check-circle-fill text-success fs-4 d-block mb-2"></i>
                            စိစစ်ရန် အလှူငွေ မရှိပါ
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var d in Model.RecentPendingDonations)
                            {
                                <div class="list-group-item px-3 py-2">
                                    <div class="d-flex align-items-start gap-2">
                                        <img src="@d.TransferScreenshot" class="rounded" width="40" height="40"
                                             style="object-fit:cover;flex-shrink:0;cursor:pointer;"
                                             onclick="openScreenshot('@d.TransferScreenshot')" alt="screenshot" />
                                        <div class="flex-grow-1 min-width-0">
                                            <div class="fw-semibold text-truncate">@d.DonorName</div>
                                            <div class="text-muted small text-truncate">Campaign: @d.CampaignTitle</div>
                                        </div>
                                        <a asp-controller="Admin" asp-action="Donations"
                                           class="btn btn-sm btn-outline-primary py-0 px-2 flex-shrink-0">စိစစ်မည်</a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="row g-3 mt-2">
        <div class="col-12">
            <div class="card p-3 shadow-sm border-0">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Admin" asp-action="Campaigns" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-megaphone me-1"></i>Campaign များ စီမံမည်
                    </a>
                    <a asp-controller="Admin" asp-action="Donations" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-cash-stack me-1"></i>အလှူငွေများ စီမံမည်
                    </a>
                    <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-people me-1"></i>အသုံးပြုသူများ စီမံမည်
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Screenshot Modal -->
<div class="modal fade" id="screenshotModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-image me-2"></i>ငွေလွှဲပြေစာ Screenshot</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="screenshotModalImg" src="" class="img-fluid rounded-xl screenshot-preview" alt="" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openScreenshot(url) {
            document.getElementById('screenshotModalImg').src = url;
            new bootstrap.Modal(document.getElementById('screenshotModal')).show();
        }

        // Real-time Dashboard listeners
        $(document).on('adminDashboardStats', function (e, data) {
            if (data.pendingCampaigns !== undefined) $('#statPendingCampaigns').text(data.pendingCampaigns);
            if (data.openCampaigns !== undefined) $('#statOpenCampaigns').text(data.openCampaigns);
            if (data.goalReachedCampaigns !== undefined) $('#statGoalReachedCampaigns').text(data.goalReachedCampaigns);
            if (data.completedCampaigns !== undefined) $('#statCompletedCampaigns').text(data.completedCampaigns);
            if (data.pendingDonations !== undefined) $('#statPendingDonations').text(data.pendingDonations);
            if (data.totalApprovedAmount !== undefined) $('#statTotalApprovedAmount').text(parseFloat(data.totalApprovedAmount).toLocaleString('en-US'));
        });

        $(document).on('donationCreated', function (e, data) {
            var cur = parseInt($('#statPendingDonations').text()) || 0;
            $('#statPendingDonations').text(cur + 1);

            // Prepend to recent list
            var container = $('#recentPendingDonationsContainer');
            var list = container.find('.list-group');
            if (!list.length) {
                container.html('<div class="list-group list-group-flush"></div>');
                list = container.find('.list-group');
            }
            var item = '<div class="list-group-item px-3 py-2 bg-light-blue" style="transition:background 2s;">' +
                '<div class="d-flex align-items-start gap-2">' +
                '<img src="' + Danation.escHtml(data.transferScreenshot) + '" class="rounded" width="40" height="40" style="object-fit:cover;flex-shrink:0;cursor:pointer;" onclick="openScreenshot(\'' + Danation.escHtml(data.transferScreenshot) + '\')" alt="screenshot" />' +
                '<div class="flex-grow-1 min-width-0">' +
                '<div class="fw-semibold text-truncate">' + Danation.escHtml(data.donorName) + '</div>' +
                '<div class="text-muted small text-truncate">Campaign: ' + Danation.escHtml(data.campaignTitle) + '</div>' +
                '</div>' +
                '<a href="/Admin/Donations" class="btn btn-sm btn-outline-primary py-0 px-2 flex-shrink-0">စိစစ်မည်</a>' +
                '</div></div>';
            list.prepend(item);
            setTimeout(function () { list.find('.bg-light-blue').removeClass('bg-light-blue'); }, 3000);
        });

        $(document).on('campaignCreated', function (e, data) {
            var cur = parseInt($('#statPendingCampaigns').text()) || 0;
            $('#statPendingCampaigns').text(cur + 1);

            var curTotal = parseInt($('#statTotalCampaigns').text()) || 0;
            $('#statTotalCampaigns').text(curTotal + 1);

            var container = $('#recentPendingCampaignsContainer');
            var list = container.find('.list-group');
            if (!list.length) {
                container.html('<div class="list-group list-group-flush"></div>');
                list = container.find('.list-group');
            }
            var item = '<div class="list-group-item px-3 py-2 bg-light-blue" style="transition:background 2s;">' +
                '<div class="d-flex align-items-start gap-2">' +
                '<div class="flex-grow-1 min-width-0">' +
                '<div class="fw-semibold text-truncate">' + Danation.escHtml(data.title) + '</div>' +
                '<div class="text-muted small">' + Danation.escHtml(data.ownerName) + ' မှ · ပန်းတိုင်: ' + Danation.formatMMK(data.goalAmount) + '</div>' +
                '</div>' +
                '<div class="flex-shrink-0">' +
                '<a href="/Admin/CampaignDetail/' + data.id + '" class="btn btn-sm btn-outline-primary py-0 px-2">စိစစ်မည်</a>' +
                '</div></div></div>';
            list.prepend(item);
            setTimeout(function () { list.find('.bg-light-blue').removeClass('bg-light-blue'); }, 3000);
        });

        $(document).on('campaignStatusChanged', function (e, data) {
            if (data.status === 'OPEN') {
                var pend = Math.max(0, (parseInt($('#statPendingCampaigns').text()) || 1) - 1);
                $('#statPendingCampaigns').text(pend);
                var op = (parseInt($('#statOpenCampaigns').text()) || 0) + 1;
                $('#statOpenCampaigns').text(op);
            } else if (data.status === 'REJECTED') {
                var pend = Math.max(0, (parseInt($('#statPendingCampaigns').text()) || 1) - 1);
                $('#statPendingCampaigns').text(pend);
            } else if (data.status === 'CLOSED') {
                var op = Math.max(0, (parseInt($('#statOpenCampaigns').text()) || 1) - 1);
                $('#statOpenCampaigns').text(op);
            } else if (data.status === 'COMPLETED') {
                var comp = (parseInt($('#statCompletedCampaigns').text()) || 0) + 1;
                $('#statCompletedCampaigns').text(comp);
            }
        });
    </script>
}
