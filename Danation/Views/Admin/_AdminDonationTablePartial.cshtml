@model List<AdminDonationSummaryViewModel>

<div class="table-responsive">
    <table class="table table-hover mb-0" id="donationsTable">
        <thead>
            <tr>
                <th>Screenshot</th>
                <th>Donor</th>
                <th>Campaign</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No donations found.</td>
                </tr>
            }
            @foreach (var d in Model)
            {
                var statusClass = d.Status switch
                {
                    "APPROVED" => "badge-approved",
                    "REJECTED" => "badge-rejected",
                    _ => "badge-pending"
                };
                <tr data-id="@d.Id">
                    <td>
                        <img src="@d.TransferScreenshot" class="rounded" width="52" height="52"
                             style="object-fit:cover;cursor:pointer;"
                             onclick="openScreenshot('@d.TransferScreenshot')" alt="screenshot"
                             title="Click to view" />
                    </td>
                    <td>
                        <div class="fw-semibold small">@d.DonorName</div>
                        <div class="text-muted" style="font-size:11px;">@d.DonorEmail</div>
                    </td>
                    <td>
                        <a asp-controller="Campaign" asp-action="Detail" asp-route-id="@d.CampaignId"
                           class="text-decoration-none small fw-medium" target="_blank">@d.CampaignTitle</a>
                    </td>
                    <td class="fw-semibold small">
                        @if (d.Amount.HasValue)
                        {
                            <span class="text-success">@d.Amount.Value.ToString("N0") MMK</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td><span class="badge @statusClass don-status-badge">@d.Status</span></td>
                    <td class="small text-muted">
                        @d.CreatedAt.ToString("MMM d, yyyy")
                        @if (d.VerifiedAt.HasValue)
                        {
                            <br /><span class="text-muted" style="font-size:11px;">Verified: @d.VerifiedAt.Value.ToString("MMM d")</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (d.Status == "PENDING")
                        {
                            <div class="d-flex justify-content-end gap-1">
                                <button class="btn btn-sm btn-success approve-don-btn" data-id="@d.Id" title="Approve">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button class="btn btn-sm btn-danger reject-don-btn" data-id="@d.Id" title="Reject">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">@(d.VerifiedByName ?? "—")</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
