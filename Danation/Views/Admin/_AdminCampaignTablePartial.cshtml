@model List<AdminCampaignSummaryViewModel>

<div class="table-responsive">
    <table class="table table-hover mb-0" id="campaignsTable">
        <thead>
            <tr>
                <th>Campaign</th>
                <th>Owner</th>
                <th>Goal</th>
                <th>Status</th>
                <th>Created</th>
                <th>Files</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No campaigns found.</td>
                </tr>
            }
            @foreach (var c in Model)
            {
                var statusClass = c.Status switch
                {
                    "OPEN" => "badge-open",
                    "GOAL_REACHED" => "badge-goal",
                    "CLOSED" => "badge-closed",
                    "COMPLETED" => "badge-completed",
                    "REJECTED" => "badge-rejected",
                    _ => "badge-pending"
                };
                <tr data-id="@c.Id">
                    <td>
                        <div class="fw-semibold" style="max-width:200px;">
                            <a asp-controller="Admin" asp-action="CampaignDetail" asp-route-id="@c.Id"
                               class="text-dark text-decoration-none">@c.Title</a>
                        </div>
                    </td>
                    <td class="small">
                        <span class="fw-medium">@c.OwnerName</span><br />
                        <span class="text-muted">@@@c.OwnerUsername</span>
                        @if (!string.IsNullOrEmpty(c.ContactPhone))
                        {
                            <div class="text-primary mt-1" style="font-size:11px;">
                                <i class="bi bi-telephone-fill me-1"></i>@c.ContactPhone
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(c.Township))
                        {
                            <div class="text-muted" style="font-size:11px;">
                                <i class="bi bi-geo-alt me-1"></i>@c.Township
                            </div>
                        }
                    </td>
                    <td class="small">@c.GoalAmount.ToString("N0") MMK</td>
                    <td><span class="badge @statusClass status-badge">@c.Status.Replace("_", " ")</span></td>
                    <td class="small text-muted">@c.CreatedAt.ToString("MMM d, yyyy")</td>
                    <td class="small">
                        <span title="Images"><i class="bi bi-images me-1"></i>@c.ImageCount</span>
                        <span class="ms-2" title="Docs"><i class="bi bi-file-earmark me-1"></i>@c.DocumentCount</span>
                    </td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-1 flex-wrap">
                            <a asp-controller="Admin" asp-action="CampaignDetail" asp-route-id="@c.Id"
                               class="btn btn-sm btn-outline-secondary" title="View">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (c.Status == "PENDING")
                            {
                                <button class="btn btn-sm btn-success approve-btn" data-id="@c.Id" title="Approve">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button class="btn btn-sm btn-danger reject-btn" data-id="@c.Id" title="Reject">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                            @if (c.Status == "GOAL_REACHED")
                            {
                                <button class="btn btn-sm btn-warning close-btn" data-id="@c.Id" title="Close Campaign">
                                    <i class="bi bi-lock"></i>
                                </button>
                            }
                            @if (c.Status == "CLOSED")
                            {
                                <a asp-controller="Admin" asp-action="CreateCompletion" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-primary" title="Create Completion">
                                    <i class="bi bi-trophy"></i>
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
