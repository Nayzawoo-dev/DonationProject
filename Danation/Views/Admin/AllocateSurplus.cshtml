@model AdminSurplusAllocationViewModel
@{
    ViewData["Title"] = "ပိုလျှံရန်ပုံငွေ ခွဲဝေမှု — Admin";
    Layout = "_Layout";
    var sourceCandidates = ViewBag.SourceCandidates as List<AdminCampaignSummaryViewModel> ?? new List<AdminCampaignSummaryViewModel>();
    var targetCampaigns = ViewBag.TargetCampaigns as List<CampaignListItemViewModel> ?? new List<CampaignListItemViewModel>();
}

<div class="admin-page-header">
    <div class="container">
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-light" title="ဒက်ရှ်ဘုတ်သို့ ပြန်သွားရန်">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="mb-1 fs-4"><i class="bi bi-cash-stack me-2"></i>ပိုလျှံရန်ပုံငွေ ခွဲဝေမှုစနစ်</h1>
                <p class="mb-0 opacity-75">ရည်မှန်းချက်ကျော်လွန်ရရှိထားသော Campaign မှ ပိုလျှံငွေများကို အကူအညီလိုအပ်နေသော အခြား Campaign များထံ လွှဲပြောင်းပေးအပ်ခြင်း</p>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="alert alert-info border-0 mb-4 shadow-sm">
                <div class="d-flex align-items-start">
                    <i class="bi bi-info-circle-fill fs-5 me-3 text-primary mt-1"></i>
                    <div>
                        <div class="fw-bold">ပိုလျှံငွေ စာရင်းကိုင် စည်းမျဉ်းများ</div>
                        <div class="small">
                            ပိုလျှံငွေဆိုသည်မှာ ပန်းတိုင်ပြည့် သို့မဟုတ် ပြီးမြောက်သွားသော Campaign တစ်ခုတွင် ရည်မှန်းချက်ထက် ကျော်လွန်လက်ခံရရှိထားသော အလှူငွေဖြစ်ပါသည်။
                            ပိုလျှံငွေခွဲဝေခြင်းဖြင့် အကူအညီလိုအပ်နေသော အခြားဖွင့်လှစ်ဆဲ Campaign များထံ တိုက်ရိုက်လွှဲပြောင်းပေးနိုင်ပါသည်။
                            ခွဲဝေမှုအားလုံးကို စနစ်တကျ မှတ်တမ်းတင်ထားပြီး ရရှိနိုင်သော ပိုလျှံငွေပမာဏထက် ကျော်လွန်ခွဲဝေ၍ မရပါ။
                        </div>
                    </div>
                </div>
            </div>

            <div class="card p-4 shadow-sm border-0">
                <form id="allocateSurplusForm" asp-action="AllocateSurplus" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-4"></div>

                    <!-- Source Campaign Selection -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="bi bi-box-arrow-up-right me-1 text-primary"></i>မူလ Campaign (ပိုလျှံငွေ ထုတ်ပေးမည့် Campaign)
                        </label>
                        <select id="sourceCampaignSelect" class="form-select form-select-lg mb-2" onchange="changeSourceCampaign(this.value)">
                            @foreach (var src in sourceCandidates)
                            {
                                if (src.Id == Model.SourceCampaignId)
                                {
                                    <option value="@src.Id" selected="selected">
                                        @src.Title — ခွဲဝေနိုင်ငွေ: @src.AvailableSurplus.ToString("N0") ကျပ်
                                    </option>
                                }
                                else
                                {
                                    <option value="@src.Id">
                                        @src.Title — ခွဲဝေနိုင်ငွေ: @src.AvailableSurplus.ToString("N0") ကျပ်
                                    </option>
                                }
                            }
                        </select>
                        <input type="hidden" asp-for="SourceCampaignId" />
                        <input type="hidden" asp-for="SourceCampaignTitle" />
                        <input type="hidden" asp-for="SourceAvailableSurplus" id="sourceMaxSurplus" />

                        <div class="p-3 bg-light rounded-xl border d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small">ခွဲဝေနိုင်သော ပိုလျှံငွေ စုစုပေါင်း:</span>
                                <div class="fs-4 fw-bold text-success" id="availableSurplusDisplay">
                                    @Model.SourceAvailableSurplus.ToString("N0") ကျပ်
                                </div>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                                <i class="bi bi-check2-circle me-1"></i>စိစစ်ပြီး ရန်ပုံငွေ
                            </span>
                        </div>
                    </div>

                    <!-- Target Campaign Selection -->
                    <div class="mb-4">
                        <label asp-for="TargetCampaignId" class="form-label fw-bold">
                            <i class="bi bi-box-arrow-in-down-left me-1 text-success"></i>လက်ခံမည့် Campaign (အလှူငွေ လိုအပ်နေသော Campaign) <span class="text-danger">*</span>
                        </label>
                        @if (targetCampaigns.Count == 0)
                        {
                            <div class="alert alert-warning border-0 mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>အလှူငွေ လက်ခံနိုင်သော ဖွင့်လှစ်ဆဲ Campaign မရှိသေးပါ။
                            </div>
                        }
                        else
                        {
                            <select asp-for="TargetCampaignId" class="form-select" required>
                                <option value="">-- လက်ခံမည့် Campaign ရွေးချယ်ပါ --</option>
                                @foreach (var tgt in targetCampaigns)
                                {
                                    <option value="@tgt.Id">
                                        @tgt.Title (ရည်မှန်းချက်: @tgt.GoalAmount.ToString("N0") ကျပ် | ရရှိပြီး: @tgt.RaisedAmount.ToString("N0") ကျပ် | လိုအပ်ငွေ: @tgt.RemainingAmount.ToString("N0") ကျပ်)
                                    </option>
                                }
                            </select>
                        }
                        <span asp-validation-for="TargetCampaignId" class="text-danger small"></span>
                        <div class="form-text">အတည်ပြုပြီး၍ ဖွင့်လှစ်နေဆဲ (OPEN) ဖြစ်သော Campaign များသာ ပိုလျှံငွေ လက်ခံနိုင်ပါသည်။</div>
                    </div>

                    <!-- Allocation Amount -->
                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label fw-bold">
                            <i class="bi bi-cash me-1 text-primary"></i>ခွဲဝေမည့် ငွေပမာဏ (ကျပ်) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-lg">
                            <input asp-for="Amount" type="number" step="1000" min="1" max="@Model.SourceAvailableSurplus"
                                   id="allocationAmountInput" class="form-control fw-bold" placeholder="0" required />
                            <span class="input-group-text">ကျပ်</span>
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>

                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setAllocationPercent(0.25)">25%</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setAllocationPercent(0.50)">50%</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setAllocationPercent(0.75)">75%</button>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="setAllocationPercent(1.0)">100% (အများဆုံး)</button>
                        </div>
                    </div>

                    <!-- Notes -->
                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold">
                            စီမံခန့်ခွဲမှု မှတ်ချက်နှင့် အကြောင်းပြချက် (ရွေးချယ်နိုင်သည်)
                        </label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="ဤခွဲဝေမှုကို အတည်ပြုရသည့် အကြောင်းရင်း (ဥပမာ - အရေးပေါ်ကယ်ဆယ်ရေး၊ ဆေးကုသမှု လိုအပ်ချက် စသည်)..."
                                  maxlength="500"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                        <div class="form-text">ဤမှတ်ချက်ကို ဘဏ္ဍာရေး စာရင်းစစ်မှတ်တမ်းတွင် ထိန်းသိမ်းထားမည်ဖြစ်ပါသည်။</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">
                            မလုပ်တော့ပါ
                        </a>
                        <button type="submit" class="btn btn-primary px-4 py-2" id="submitAllocationBtn" @(targetCampaigns.Count == 0 || Model.SourceAvailableSurplus <= 0 ? "disabled" : "")>
                            <i class="bi bi-arrow-left-right me-2"></i>ပိုလျှံငွေ ခွဲဝေမှု အတည်ပြုဆောင်ရွက်မည်
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var maxSurplus = parseFloat('@Model.SourceAvailableSurplus');

        function changeSourceCampaign(id) {
            window.location.href = '/Admin/AllocateSurplus?sourceCampaignId=' + id;
        }

        function setAllocationPercent(percent) {
            var val = Math.floor(maxSurplus * percent);
            $('#allocationAmountInput').val(val);
        }

        $('#allocateSurplusForm').on('submit', function (e) {
            var amt = parseFloat($('#allocationAmountInput').val());
            if (isNaN(amt) || amt <= 0) {
                e.preventDefault();
                Notiflix.Notify.warning('ကျေးဇူးပြု၍ သုညထက် ကြီးသော တရားဝင်ငွေပမာဏ ထည့်သွင်းပါ။');
                return false;
            }
            if (amt > maxSurplus) {
                e.preventDefault();
                Notiflix.Notify.failure('ခွဲဝေမည့်ငွေပမာဏသည် ရရှိနိုင်သော ပိုလျှံငွေ ' + maxSurplus.toLocaleString() + ' ကျပ်ထက် မကျော်လွန်ရပါ။');
                return false;
            }
            var targetId = $('#TargetCampaignId').val();
            if (!targetId) {
                e.preventDefault();
                Notiflix.Notify.warning('ကျေးဇူးပြု၍ လက်ခံမည့် Campaign ကို ရွေးချယ်ပါ။');
                return false;
            }
        });
    </script>
}
