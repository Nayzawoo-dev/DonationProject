@model List<AdminUserViewModel>
@{
    ViewData["Title"] = "Manage Users — Admin";
    Layout = "_Layout";
    var search = ViewBag.Search as string;
}

<div class="admin-page-header">
    <div class="container">
        <h1 class="mb-1"><i class="bi bi-people me-2"></i>Manage Users</h1>
        <p class="mb-0 opacity-75">@Model.Count user@(Model.Count != 1 ? "s" : "") registered</p>
    </div>
</div>

<div class="container py-4">
    <!-- Search -->
    <form method="get" asp-action="Users" asp-controller="Admin" class="row g-2 mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-start-0 ps-0"
                       placeholder="Search name, email, or username…" />
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
        </div>
        @if (!string.IsNullOrEmpty(search))
        {
            <div class="col-auto">
                <a asp-action="Users" asp-controller="Admin" class="btn btn-outline-secondary">Clear</a>
            </div>
        }
    </form>

    <div class="card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="usersTable">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Activity</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No users found.</td>
                    </tr>
                }
                @foreach (var u in Model)
                {
                    <tr data-id="@u.Id">
                        <td>
                            <div class="fw-semibold">@u.FullName</div>
                            <div class="text-muted small">@@@u.Username</div>
                        </td>
                        <td class="small">
                            @u.Email
                            @if (u.EmailVerified)
                            {
                                <i class="bi bi-patch-check-fill text-success ms-1" title="Verified"></i>
                            }
                        </td>
                        <td class="small text-muted">@(u.Phone ?? "—")</td>
                        <td class="small">
                            <span title="Campaigns"><i class="bi bi-megaphone me-1"></i>@u.TotalCampaigns</span>
                            <span class="ms-2" title="Donations"><i class="bi bi-heart me-1"></i>@u.TotalDonations</span>
                        </td>
                        <td class="small text-muted">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td>
                            <span class="badge user-status-badge @(u.IsActive ? "badge-approved" : "badge-rejected")">
                                @(u.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") toggle-btn"
                                    data-id="@u.Id" data-active="@u.IsActive.ToString().ToLower()"
                                    title="@(u.IsActive ? "Deactivate" : "Activate")">
                                <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                <span class="ms-1 d-none d-md-inline">@(u.IsActive ? "Deactivate" : "Activate")</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '.toggle-btn', function () {
            var btn = $(this);
            var id = btn.data('id');
            var isActive = btn.data('active') === true || btn.data('active') === 'true';
            var msg = isActive ? 'Deactivate this user? They will not be able to log in.' : 'Activate this user?';
            var row = btn.closest('tr');

            Danation.confirmPost(msg, '/Admin/ToggleUserActive', { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    if (res.isActive) {
                        btn.data('active', 'true')
                           .attr('class', 'btn btn-sm btn-outline-danger toggle-btn')
                           .attr('title', 'Deactivate')
                           .html('<i class="bi bi-person-slash"></i><span class="ms-1 d-none d-md-inline">Deactivate</span>');
                        row.find('.user-status-badge').attr('class', 'badge user-status-badge badge-approved').text('Active');
                    } else {
                        btn.data('active', 'false')
                           .attr('class', 'btn btn-sm btn-outline-success toggle-btn')
                           .attr('title', 'Activate')
                           .html('<i class="bi bi-person-check"></i><span class="ms-1 d-none d-md-inline">Activate</span>');
                        row.find('.user-status-badge').attr('class', 'badge user-status-badge badge-rejected').text('Inactive');
                    }
                }
            );
        });
    </script>
}
