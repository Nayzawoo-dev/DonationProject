@model List<AdminUserViewModel>
@{
    ViewData["Title"] = "Manage Users — Admin";
    Layout = "_Layout";
    var search = ViewBag.Search as string;
}

<div class="admin-page-header">
    <div class="container">
        <h1 class="mb-1"><i class="bi bi-people me-2"></i>Manage Users</h1>
        <p class="mb-0 opacity-75">@Model.Count user@(Model.Count != 1 ? "s" : "") registered</p>
    </div>
</div>

<div class="container py-4">
    <!-- Search Form -->
    <form id="adminUserSearchForm" method="get" asp-action="Users" asp-controller="Admin" class="row g-2 mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" id="adminUserSearchInput" value="@search" class="form-control border-start-0 ps-0"
                       placeholder="Search name, email, or username…" autocomplete="off" />
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
        </div>
        <div class="col-auto">
            <button type="button" id="clearAdminUsersBtn" class="btn btn-outline-secondary @(string.IsNullOrEmpty(search) ? "d-none" : "")">
                Clear
            </button>
        </div>
    </form>

    <div class="card p-0 overflow-hidden" id="adminUsersTableContainer">
        <partial name="_AdminUserTablePartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        var userSearchTimer = null;

        function fetchAdminUsers() {
            var form = $('#adminUserSearchForm');
            var url = '/Admin/Users?' + form.serialize();

            Danation.loadPartial(url, '#adminUsersTableContainer', function () {
                if ($('#adminUserSearchInput').val()) {
                    $('#clearAdminUsersBtn').removeClass('d-none');
                } else {
                    $('#clearAdminUsersBtn').addClass('d-none');
                }
            });
        }

        // Live search with debounce
        $('#adminUserSearchInput').on('input', function () {
            clearTimeout(userSearchTimer);
            userSearchTimer = setTimeout(fetchAdminUsers, 400);
        });

        // Form submit
        $('#adminUserSearchForm').on('submit', function (e) {
            e.preventDefault();
            fetchAdminUsers();
        });

        // Clear search
        $('#clearAdminUsersBtn').on('click', function () {
            $('#adminUserSearchInput').val('');
            fetchAdminUsers();
        });

        // Toggle user active status
        $(document).on('click', '.toggle-btn', function () {
            var btn = $(this);
            var id = btn.data('id');
            var isActive = btn.data('active') === true || btn.data('active') === 'true';
            var msg = isActive ? 'Deactivate this user? They will not be able to log in.' : 'Activate this user?';
            var row = btn.closest('tr');

            Danation.confirmPost(msg, '/Admin/ToggleUserActive', { id: id },
                function (res) {
                    Notiflix.Notify.success(res.message);
                    if (res.isActive) {
                        btn.data('active', 'true')
                           .attr('class', 'btn btn-sm btn-outline-danger toggle-btn')
                           .attr('title', 'Deactivate')
                           .html('<i class="bi bi-person-slash"></i><span class="ms-1 d-none d-md-inline">Deactivate</span>');
                        row.find('.user-status-badge').attr('class', 'badge user-status-badge badge-approved').text('Active');
                    } else {
                        btn.data('active', 'false')
                           .attr('class', 'btn btn-sm btn-outline-success toggle-btn')
                           .attr('title', 'Activate')
                           .html('<i class="bi bi-person-check"></i><span class="ms-1 d-none d-md-inline">Activate</span>');
                        row.find('.user-status-badge').attr('class', 'badge user-status-badge badge-rejected').text('Inactive');
                    }
                }
            );
        });
    </script>
}
