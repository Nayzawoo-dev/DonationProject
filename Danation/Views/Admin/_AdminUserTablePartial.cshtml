@model List<AdminUserViewModel>

<div class="table-responsive">
    <table class="table table-hover mb-0" id="usersTable">
        <thead>
            <tr>
                <th>အသုံးပြုသူ</th>
                <th>အီးမေးလ်</th>
                <th>ဖုန်းနံပါတ်</th>
                <th>လှုပ်ရှားမှု</th>
                <th>စတင်သည့်ရက်</th>
                <th>အခြေအနေ</th>
                <th class="text-end">လုပ်ဆောင်ချက်</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">အသုံးပြုသူ မတွေ့ရှိပါ။</td>
                </tr>
            }
            @foreach (var u in Model)
            {
                <tr data-id="@u.Id">
                    <td>
                        <div class="fw-semibold">@u.FullName</div>
                        <div class="text-muted small">@@@u.Username</div>
                    </td>
                    <td class="small">
                        @u.Email
                        @if (u.EmailVerified)
                        {
                            <i class="bi bi-patch-check-fill text-success ms-1" title="အတည်ပြုပြီး"></i>
                        }
                    </td>
                    <td class="small text-muted">@(u.Phone ?? "—")</td>
                    <td class="small">
                        <span title="Campaign များ"><i class="bi bi-megaphone me-1"></i>@u.TotalCampaigns</span>
                        <span class="ms-2" title="လှူဒါန်းမှုများ"><i class="bi bi-heart me-1"></i>@u.TotalDonations</span>
                    </td>
                    <td class="small text-muted">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                    <td>
                        <span class="badge user-status-badge @(u.IsActive ? "badge-approved" : "badge-rejected")">
                            @(u.IsActive ? "အသုံးပြုနိုင်" : "ပိတ်ပင်ထား")
                        </span>
                    </td>
                    <td class="text-end">
                        <a asp-controller="Profile" asp-action="Public" asp-route-id="@u.Id"
                           class="btn btn-sm btn-outline-secondary" title="အသေးစိတ်ကြည့်ရန်">
                            <i class="bi bi-eye"></i>
                        </a>
                        <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") toggle-btn"
                                data-id="@u.Id" data-active="@u.IsActive.ToString().ToLower()"
                                title="@(u.IsActive ? "ပိတ်ပင်မည်" : "ခွင့်ပြုမည်")">
                            <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                            <span class="ms-1 d-none d-md-inline">@(u.IsActive ? "ပိတ်ပင်မည်" : "ခွင့်ပြုမည်")</span>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
