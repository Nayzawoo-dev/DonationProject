@model CreateCampaignViewModel
@{
    ViewData["Title"] = "Campaign ဖန်တီးရန် — Danation";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex align-items-center mb-4">
                <a asp-controller="Campaign" asp-action="My" class="btn btn-sm btn-outline-secondary me-3" title="ပြန်သွားမည်">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="fw-bold mb-0">Campaign အသစ် ဖန်တီးမည်</h2>
                    <p class="text-muted small mb-0">အောက်ပါ အချက်အလက်များကို ဖြည့်စွက်ပါ။ သင်၏ Campaign ကို လူထုထံ မပြသမီ Admin မှ ဦးစွာ စိစစ်အတည်ပြုပါမည်။</p>
                </div>
            </div>

            <div class="card p-4 shadow-sm border-0">
                <form id="createCampaignForm">
                    @Html.AntiForgeryToken()

                    <!-- Title -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="titleInput">Campaign ခေါင်းစဉ် <span class="text-danger">*</span></label>
                        <input type="text" id="titleInput" name="Title" class="form-control"
                               placeholder="ရှင်းလင်းထိရောက်သော Campaign ခေါင်းစဉ် ရေးပါ…" maxlength="200" required />
                        <div class="form-text text-end"><span id="titleCount">0</span>/200</div>
                    </div>

                    <!-- Goal Amount -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="goalInput">ရန်ပုံငွေ ပန်းတိုင် (ကျပ်) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">MMK</span>
                            <input type="number" id="goalInput" name="GoalAmount" class="form-control"
                                   placeholder="ဥပမာ - ၅၀၀,၀၀၀" min="1000" max="100000000" step="1000" required />
                        </div>
                        <div class="form-text">အနည်းဆုံး ၁,၀၀၀ ကျပ်</div>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="descInput">အသေးစိတ် ဖော်ပြချက် <span class="text-danger">*</span></label>
                        <textarea id="descInput" name="Description" class="form-control"
                                  rows="8" placeholder="Campaign ၏ ရည်ရွယ်ချက်၊ ရန်ပုံငွေ အသုံးပြုမည့် အစီအစဉ်တို့ကို ရှင်းလင်းစွာ ရေးသားပါ (အနည်းဆုံး စာလုံး ၅၀)..."
                                  maxlength="5000" required></textarea>
                        <div class="form-text d-flex justify-content-between">
                            <span>အနည်းဆုံး စာလုံး ၅၀</span>
                            <span><span id="descCount">0</span>/5000</span>
                        </div>
                    </div>

                    <!-- Campaign Schedule (Start and End Dates) -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-muted text-uppercase small mb-3">
                            <i class="bi bi-calendar-range me-1 text-success"></i>Campaign ပြုလုပ်မည့် ကာလ
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="startDateInput">စတင်မည့် ရက်စွဲနှင့် အချိန် <span class="text-danger">*</span></label>
                                <input type="datetime-local" id="startDateInput" name="StartDate" class="form-control" required />
                                <div class="form-text">အလှူငွေများ စတင်လက်ခံမည့် အချိန်</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="endDateInput">ပြီးဆုံးမည့် ရက်စွဲနှင့် အချိန် <span class="text-danger">*</span></label>
                                <input type="datetime-local" id="endDateInput" name="EndDate" class="form-control" required />
                                <div class="form-text">စတင်သည့် အချိန်ထက် နောက်ကျရမည်</div>
                            </div>
                        </div>
                    </div>

                    <!-- Location Section -->
                    <div class="mb-3">
                        <h6 class="fw-bold text-muted text-uppercase small mb-3">
                            <i class="bi bi-geo-alt me-1 text-success"></i>တည်နေရာ
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label small fw-semibold" for="addressInput">လိပ်စာ အပြည့်အစုံ <span class="text-danger">*</span></label>
                                <input type="text" id="addressInput" name="Address" class="form-control"
                                       placeholder="ဥပမာ - အမှတ် (၁၂)၊ ပြည်လမ်း၊ ကမာရွတ်…" maxlength="500" required />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold" for="townshipInput">မြို့နယ် <span class="text-danger">*</span></label>
                                <input type="text" id="townshipInput" name="Township" class="form-control"
                                       placeholder="ဥပမာ - ကမာရွတ်၊ ရန်ကုန်" maxlength="100" required />
                            </div>
                        </div>
                    </div>

                    <!-- Contact Phone -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="contactPhoneInput">
                            ဆက်သွယ်ရန် ဖုန်းနံပါတ် <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                            <input type="text" id="contactPhoneInput" name="ContactPhone" class="form-control"
                                   placeholder="ဥပမာ - 09123456789" maxlength="30" required />
                        </div>
                        <div class="form-text">
                            <i class="bi bi-lock-fill me-1 text-warning"></i>
                            ဤဖုန်းနံပါတ်ကို <strong>Admin သာလျှင် မြင်တွေ့ရမည်ဖြစ်ပြီး</strong> အများပြည်သူထံ မပြသပါ။
                        </div>
                    </div>

                    <div class="alert alert-info border-0 mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Campaign တင်သွင်းပြီးနောက် Admin အဖွဲ့မှ လိုအပ်သော စာရွက်စာတမ်းများနှင့် ဓာတ်ပုံအထောက်အထားများ တောင်းဆိုနိုင်ပါသည်။ အချက်အလက် မမှန်ကန်ခြင်း သို့မဟုတ် အထောက်အထား မပြည့်စုံပါက Admin မှ လက်ခံမည်မဟုတ်ကြောင်း အသိပေးအပ်ပါသည်။
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary px-4" id="createBtn">
                            <i class="bi bi-check-circle me-2"></i>Campaign တင်သွင်းမည်
                        </button>
                        <a asp-controller="Campaign" asp-action="My" class="btn btn-outline-secondary">မလုပ်တော့ပါ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Character counters
        $('#titleInput').on('input', function () {
            $('#titleCount').text($(this).val().length);
        });
        $('#descInput').on('input', function () {
            $('#descCount').text($(this).val().length);
        });

        // AJAX submit
        $('#createCampaignForm').on('submit', function (e) {
            e.preventDefault();
            var start = $('#startDateInput').val();
            var end = $('#endDateInput').val();
            if (!start || !end) {
                Notiflix.Notify.warning('စတင်မည့်ရက်နှင့် ပြီးဆုံးမည့်ရက် နှစ်ခုလုံး ထည့်သွင်းပေးပါ။');
                return;
            }
            if (new Date(end) <= new Date(start)) {
                Notiflix.Notify.warning('ပြီးဆုံးမည့်ရက်သည် စတင်မည့်ရက်ထက် နောက်ကျရပါမည်။');
                return;
            }

            var btn = $('#createBtn');
            if (btn.prop('disabled')) return;
            btn.prop('disabled', true);

            Danation.post('/Campaign/Create', $(this).serialize(),
                function (res) {
                    Notiflix.Notify.success(res.message);
                    if (res.redirectUrl) {
                        setTimeout(function () { window.location.href = res.redirectUrl; }, 1200);
                    }
                },
                function () { btn.prop('disabled', false); }
            );
        });
    </script>
}
