@model CampaignListViewModel
@{
    ViewData["Title"] = "Campaigns — Danation";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="admin-page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="mb-1"><i class="bi bi-grid-3x3-gap me-2"></i>All Campaigns</h1>
                <p class="mb-0 opacity-75" id="campaignHeaderCount">@Model.TotalCount campaign@(Model.TotalCount != 1 ? "s" : "") found</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("ADMIN"))
            {
                <div class="col-auto">
                    <a asp-controller="Campaign" asp-action="Create" class="btn btn-warning fw-bold">
                        <i class="bi bi-plus-circle me-2"></i>Start a Campaign
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Search & Filter Form -->
    <form id="campaignFilterForm" method="get" asp-action="Index" asp-controller="Campaign" class="row g-2 mb-4">
        <input type="hidden" name="page" id="pageInput" value="@Model.CurrentPage" />
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" id="searchInput" value="@Model.SearchTerm"
                       class="form-control border-start-0 ps-0" placeholder="Search campaigns…" autocomplete="off" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                <input type="text" name="township" id="townshipInput" value="@Model.TownshipFilter"
                       class="form-control border-start-0 ps-0" placeholder="Filter by township…" autocomplete="off" />
            </div>
        </div>
        <div class="col-md-2">
            <select name="status" id="statusSelect" class="form-select">
                <option value="">All Statuses</option>
                @{
                    string[] pubStatuses = { "OPEN", "GOAL_REACHED", "CLOSED", "COMPLETED" };
                    string[] pubLabels   = { "Open", "Goal Reached", "Closed", "Completed" };
                    for (int si = 0; si < pubStatuses.Length; si++)
                    {
                        if (Model.StatusFilter == pubStatuses[si])
                        {
                            <option value="@pubStatuses[si]" selected="selected">@pubLabels[si]</option>
                        }
                        else
                        {
                            <option value="@pubStatuses[si]">@pubLabels[si]</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Search</button>
                <button type="button" id="clearFiltersBtn" class="btn btn-outline-secondary @(string.IsNullOrEmpty(Model.SearchTerm) && string.IsNullOrEmpty(Model.StatusFilter) && string.IsNullOrEmpty(Model.TownshipFilter) ? "d-none" : "")">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </button>
            </div>
        </div>
    </form>

    <!-- AJAX Dynamic Results Container -->
    <div id="campaignResultsContainer">
        <partial name="_CampaignListPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        var searchDebounceTimer = null;

        function fetchCampaigns(pushState) {
            var form = $('#campaignFilterForm');
            var formData = form.serialize();
            var url = '/Campaign/Index?' + formData;

            if (pushState !== false) {
                window.history.pushState(null, '', url);
            }

            Danation.loadPartial(url, '#campaignResultsContainer', function () {
                var totalCount = $('#partialTotalCount').val();
                if (totalCount !== undefined) {
                    var s = totalCount === '1' ? '' : 's';
                    $('#campaignHeaderCount').text(totalCount + ' campaign' + s + ' found');
                }

                var hasFilters = $('#searchInput').val() || $('#townshipInput').val() || $('#statusSelect').val();
                if (hasFilters) {
                    $('#clearFiltersBtn').removeClass('d-none');
                } else {
                    $('#clearFiltersBtn').addClass('d-none');
                }
            });
        }

        // Form submit
        $('#campaignFilterForm').on('submit', function (e) {
            e.preventDefault();
            $('#pageInput').val(1);
            fetchCampaigns();
        });

        // Status change
        $('#statusSelect').on('change', function () {
            $('#pageInput').val(1);
            fetchCampaigns();
        });

        // Search inputs debounce
        $('#searchInput, #townshipInput').on('input', function () {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(function () {
                $('#pageInput').val(1);
                fetchCampaigns();
            }, 450);
        });

        // Pagination click (delegated)
        $(document).on('click', '.campaign-page-link', function (e) {
            e.preventDefault();
            var page = $(this).data('page');
            if (page) {
                $('#pageInput').val(page);
                fetchCampaigns();
                $('html, body').animate({ scrollTop: $('#campaignFilterForm').offset().top - 80 }, 200);
            }
        });

        // Clear all filters
        $(document).on('click', '#clearFiltersBtn, .clear-all-filters-btn', function (e) {
            e.preventDefault();
            $('#searchInput').val('');
            $('#townshipInput').val('');
            $('#statusSelect').val('');
            $('#pageInput').val(1);
            fetchCampaigns();
        });

        // Clear specific filter badge
        $(document).on('click', '.clear-filter-btn', function (e) {
            e.preventDefault();
            var filter = $(this).data('filter');
            if (filter === 'search') $('#searchInput').val('');
            if (filter === 'township') $('#townshipInput').val('');
            if (filter === 'status') $('#statusSelect').val('');
            $('#pageInput').val(1);
            fetchCampaigns();
        });

        // Browser back/forward button support
        window.addEventListener('popstate', function () {
            var params = new URLSearchParams(window.location.search);
            $('#searchInput').val(params.get('search') || '');
            $('#townshipInput').val(params.get('township') || '');
            $('#statusSelect').val(params.get('status') || '');
            $('#pageInput').val(params.get('page') || 1);
            fetchCampaigns(false);
        });
    </script>
}
