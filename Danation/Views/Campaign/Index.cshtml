@model CampaignListViewModel
@{
    ViewData["Title"] = "Campaign များ — Danation";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="admin-page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="mb-1"><i class="bi bi-grid-3x3-gap me-2"></i>Campaign များ</h1>
                <p class="mb-0 opacity-75" id="campaignHeaderCount">
                    @Model.TotalCount ခု တွေ့ရှိသည်
                </p>
            </div>
            @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("ADMIN"))
            {
                <div class="col-auto">
                    <a asp-controller="Campaign" asp-action="Create" class="btn btn-warning fw-bold">
                        <i class="bi bi-plus-circle me-2"></i>Campaign ဖွင့်မည်
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Search & Filter Form -->
    <form id="campaignFilterForm" method="get" asp-action="Index" asp-controller="Campaign" class="row g-2 mb-4">
        <input type="hidden" name="page" id="pageInput" value="@Model.CurrentPage" />
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" id="searchInput" value="@Model.SearchTerm"
                       class="form-control border-start-0 ps-0" placeholder="Campaign ရှာဖွေပါ…" autocomplete="off" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                <input type="text" name="township" id="townshipInput" value="@Model.TownshipFilter"
                       class="form-control border-start-0 ps-0" placeholder="မြို့နယ်ဖြင့် စစ်ထုတ်ပါ…" autocomplete="off" />
            </div>
        </div>
        <div class="col-md-2">
            <select name="status" id="statusSelect" class="form-select">
                <option value="">အခြေအနေ အားလုံး</option>
                @{
                    string[] pubStatuses = { "OPEN", "GOAL_REACHED", "CLOSED", "COMPLETED" };
                    string[] pubLabels   = { "ဖွင့်လှစ်နေသည်", "ပန်းတိုင် ရောက်ပြီ", "ပိတ်ပြီး", "ပြီးမြောက်ပြီး" };
                    for (int si = 0; si < pubStatuses.Length; si++)
                    {
                        if (Model.StatusFilter == pubStatuses[si])
                        {
                            <option value="@pubStatuses[si]" selected="selected">@pubLabels[si]</option>
                        }
                        else
                        {
                            <option value="@pubStatuses[si]">@pubLabels[si]</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>ရှာဖွေမည်</button>
                <button type="button" id="clearFiltersBtn" class="btn btn-outline-secondary @(string.IsNullOrEmpty(Model.SearchTerm) && string.IsNullOrEmpty(Model.StatusFilter) && string.IsNullOrEmpty(Model.TownshipFilter) ? "d-none" : "")">
                    <i class="bi bi-x-circle me-1"></i>ရှင်းမည်
                </button>
            </div>
        </div>
    </form>

    <!-- AJAX Dynamic Results Container -->
    <div id="campaignResultsContainer">
        <partial name="_CampaignListPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        var searchDebounceTimer = null;

        function fetchCampaigns(pushState) {
            var form = $('#campaignFilterForm');
            var formData = form.serialize();
            var url = '/Campaign/Index?' + formData;

            if (pushState !== false) {
                window.history.pushState(null, '', url);
            }

            Danation.loadPartial(url, '#campaignResultsContainer', function () {
                var totalCount = $('#partialTotalCount').val();
                if (totalCount !== undefined) {
                    $('#campaignHeaderCount').text(totalCount + ' ခု တွေ့ရှိသည်');
                }

                var hasFilters = $('#searchInput').val() || $('#townshipInput').val() || $('#statusSelect').val();
                if (hasFilters) {
                    $('#clearFiltersBtn').removeClass('d-none');
                } else {
                    $('#clearFiltersBtn').addClass('d-none');
                }
            });
        }

        // Form submit
        $('#campaignFilterForm').on('submit', function (e) {
            e.preventDefault();
            $('#pageInput').val(1);
            fetchCampaigns();
        });

        // Status change
        $('#statusSelect').on('change', function () {
            $('#pageInput').val(1);
            fetchCampaigns();
        });

        // Search inputs debounce
        $('#searchInput, #townshipInput').on('input', function () {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(function () {
                $('#pageInput').val(1);
                fetchCampaigns();
            }, 450);
        });

        // Pagination click (delegated)
        $(document).on('click', '.campaign-page-link', function (e) {
            e.preventDefault();
            var page = $(this).data('page');
            if (page) {
                $('#pageInput').val(page);
                fetchCampaigns();
                $('html, body').animate({ scrollTop: $('#campaignFilterForm').offset().top - 80 }, 200);
            }
        });

        // Clear all filters
        $(document).on('click', '#clearFiltersBtn, .clear-all-filters-btn', function (e) {
            e.preventDefault();
            $('#searchInput').val('');
            $('#townshipInput').val('');
            $('#statusSelect').val('');
            $('#pageInput').val(1);
            fetchCampaigns();
        });

        // Clear specific filter badge
        $(document).on('click', '.clear-filter-btn', function (e) {
            e.preventDefault();
            var filter = $(this).data('filter');
            if (filter === 'search') $('#searchInput').val('');
            if (filter === 'township') $('#townshipInput').val('');
            if (filter === 'status') $('#statusSelect').val('');
            $('#pageInput').val(1);
            fetchCampaigns();
        });

        // Browser back/forward button support
        window.addEventListener('popstate', function () {
            var params = new URLSearchParams(window.location.search);
            $('#searchInput').val(params.get('search') || '');
            $('#townshipInput').val(params.get('township') || '');
            $('#statusSelect').val(params.get('status') || '');
            $('#pageInput').val(params.get('page') || 1);
            fetchCampaigns(false);
        });

        // Real-time: Live campaign card updates
        $(document).on('campaignDonationUpdated', function (e, data) {
            var card = $('.campaign-card[data-campaign-id="' + data.campaignId + '"]');
            if (card.length) {
                card.find('.campaign-card-raised').text(Danation.formatMMK(data.raisedAmount) + ' MMK');
                card.find('.campaign-card-percent').text(data.progressPercent + '%');
                card.find('.campaign-card-bar')
                    .css('width', data.progressPercent + '%')
                    .toggleClass('goal-reached', data.progressPercent >= 100);

                if (data.status === 'GOAL_REACHED') {
                    card.find('.campaign-card-status')
                        .attr('class', 'badge badge-goal-reached campaign-card-status')
                        .text('ပန်းတိုင် ရောက်ပြီ');
                }
            }
        });

        $(document).on('campaignStatusChanged', function (e, data) {
            var card = $('.campaign-card[data-campaign-id="' + data.campaignId + '"]');
            if (card.length) {
                var badgeCls = 'badge-' + data.status.toLowerCase().replace('_', '-');
                var text = data.status.replace('_', ' ');
                if (data.status === 'CLOSED') {
                    if (data.closeReason === 'EXPIRED') {
                        text = 'သက်တမ်းကုန်ပြီ';
                        badgeCls = 'badge-closed';
                    } else if (data.closeReason === 'GOAL_REACHED') {
                        text = 'ပန်းတိုင် ရောက်ပြီ';
                        badgeCls = 'badge-goal';
                    }
                } else if (data.status === 'OPEN') {
                    text = 'ဖွင့်လှစ်နေသည်';
                } else if (data.status === 'COMPLETED') {
                    text = 'ပြီးမြောက်ပြီး';
                }
                card.find('.campaign-card-status')
                    .attr('class', 'badge ' + badgeCls + ' campaign-card-status')
                    .text(text);
            }
        });
    </script>
}
