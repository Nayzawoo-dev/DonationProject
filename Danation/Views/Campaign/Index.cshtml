@model CampaignListViewModel
@{
    ViewData["Title"] = "Campaigns — Danation";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="admin-page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="mb-1"><i class="bi bi-grid-3x3-gap me-2"></i>All Campaigns</h1>
                <p class="mb-0 opacity-75">@Model.TotalCount campaign@(Model.TotalCount != 1 ? "s" : "") found</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("ADMIN"))
            {
                <div class="col-auto">
                    <a asp-controller="Campaign" asp-action="Create" class="btn btn-warning fw-bold">
                        <i class="bi bi-plus-circle me-2"></i>Start a Campaign
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Search & Filter -->
    <form method="get" asp-action="Index" asp-controller="Campaign" class="row g-2 mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm"
                       class="form-control border-start-0 ps-0" placeholder="Search campaigns…" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @{
                    string[] pubStatuses = { "OPEN", "GOAL_REACHED", "CLOSED", "COMPLETED" };
                    string[] pubLabels   = { "Open", "Goal Reached", "Closed", "Completed" };
                    for (int si = 0; si < pubStatuses.Length; si++)
                    {
                        if (Model.StatusFilter == pubStatuses[si])
                        {
                            <option value="@pubStatuses[si]" selected="selected">@pubLabels[si]</option>
                        }
                        else
                        {
                            <option value="@pubStatuses[si]">@pubLabels[si]</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <a asp-action="Index" asp-controller="Campaign" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </div>
    </form>

    <!-- Campaign Grid -->
    @if (Model.Campaigns.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-megaphone"></i>
            <h4>No Campaigns Found</h4>
            <p>Try adjusting your search filters or check back later.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model.Campaigns)
            {
                <div class="col-md-6 col-lg-4">
                    <a href="@Url.Action("Detail", "Campaign", new { id = c.Id })" class="text-decoration-none">
                        <div class="card campaign-card h-100">
                            @if (!string.IsNullOrEmpty(c.ThumbnailImage))
                            {
                                <img src="@c.ThumbnailImage" class="card-img-top" alt="@c.Title" style="height:200px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="campaign-card card-img-placeholder">
                                    <i class="bi bi-heart-fill text-primary" style="font-size:3rem;opacity:.4;"></i>
                                </div>
                            }
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge badge-@c.Status.ToLower().Replace("_", "-")">@c.Status.Replace("_", " ")</span>
                                    @if (c.ImageCount > 0)
                                    {
                                        <span class="text-muted small"><i class="bi bi-images me-1"></i>@c.ImageCount</span>
                                    }
                                </div>
                                <h5 class="card-title fw-bold">@c.Title</h5>
                                <p class="card-text text-muted flex-grow-1">
                                    @(c.Description.Length > 100 ? c.Description[..100] + "…" : c.Description)
                                </p>
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="fw-semibold">@c.RaisedAmount.ToString("N0") MMK raised</span>
                                        <span class="text-muted">@c.ProgressPercent%</span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar @(c.ProgressPercent >= 100 ? "goal-reached" : "")"
                                             style="width:@c.ProgressPercent%"></div>
                                    </div>
                                    <div class="text-muted small mt-1">Goal: @c.GoalAmount.ToString("N0") MMK</div>
                                </div>
                                <div class="d-flex align-items-center mt-3 pt-3 border-top">
                                    @if (!string.IsNullOrEmpty(c.OwnerProfileImage))
                                    {
                                        <img src="@c.OwnerProfileImage" class="rounded-circle me-2" width="26" height="26" style="object-fit:cover;" alt="" />
                                    }
                                    else
                                    {
                                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center me-2"
                                              style="width:26px;height:26px;background:linear-gradient(135deg,#5c6bc0,#ff7043);">
                                            <i class="bi bi-person-fill text-white" style="font-size:12px;"></i>
                                        </span>
                                    }
                                    <span class="text-muted small">@c.OwnerName</span>
                                    <span class="text-muted small ms-auto"><i class="bi bi-calendar3 me-1"></i>@c.CreatedAt.ToString("MMM d")</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5 d-flex justify-content-center" aria-label="Campaign pages">
                <ul class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                    }
                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i"
                               asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter">@i</a>
                        </li>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
