@model CampaignDetailViewModel
@{
    ViewData["Title"] = Model.Title + " — Danation";
    Layout = "_Layout";
    var statusClass = Model.Status switch
    {
        "OPEN" => "badge-open",
        "GOAL_REACHED" => "badge-goal",
        "CLOSED" => "badge-closed",
        "COMPLETED" => "badge-completed",
        "REJECTED" => "badge-rejected",
        _ => "badge-pending"
    };
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Hero Image -->
            @if (Model.Images.Count > 0)
            {
                <div class="mb-4 position-relative" style="border-radius:var(--radius);overflow:hidden;">
                    <img id="mainImage" src="@Model.Images[0].ImageUrl"
                         class="campaign-hero-img" alt="@Model.Title" style="cursor:pointer;"
                         onclick="openLightbox('@Model.Images[0].ImageUrl')" />
                </div>
                @if (Model.Images.Count > 1)
                {
                    <div class="row g-2 mb-4">
                        @foreach (var img in Model.Images)
                        {
                            <div class="col-3">
                                <img src="@img.ImageUrl" class="gallery-thumb w-100"
                                     alt="@img.Caption"
                                     onclick="switchImage('@img.ImageUrl');openLightbox('@img.ImageUrl')" />
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="campaign-card card-img-placeholder rounded-xl mb-4" style="height:300px;">
                    <i class="bi bi-heart-fill text-primary" style="font-size:5rem;opacity:.25;"></i>
                </div>
            }

            <!-- Title & Status -->
            <div class="d-flex align-items-start gap-2 mb-3 flex-wrap">
                <span class="badge @statusClass fs-6">@Model.Status.Replace("_", " ")</span>
            </div>
            <h1 class="fw-bold mb-3" style="font-size:2rem;">@Model.Title</h1>

            <!-- Owner Info — clickable link to public profile -->
            <div class="d-flex align-items-center mb-4">
                <a href="@Url.Action("Public", "Profile", new { id = Model.OwnerId })"
                   class="d-flex align-items-center text-decoration-none">
                    @if (!string.IsNullOrEmpty(Model.OwnerProfileImage))
                    {
                        <img src="@Model.OwnerProfileImage" class="rounded-circle me-2" width="36" height="36" style="object-fit:cover;" alt="" />
                    }
                    else
                    {
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center me-2"
                              style="width:36px;height:36px;background:linear-gradient(135deg,#5c6bc0,#ff7043);">
                            <i class="bi bi-person-fill text-white" style="font-size:16px;"></i>
                        </span>
                    }
                    <div>
                        <div class="fw-semibold text-dark">@Model.OwnerName</div>
                        <div class="text-muted small">@@@Model.OwnerUsername · <i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToString("MMM d, yyyy")</div>
                    </div>
                </a>
            </div>

            <!-- Description -->
            <div class="card p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-file-text me-2 text-primary"></i>About This Campaign</h5>
                <div style="white-space:pre-line;line-height:1.8;">@Model.Description</div>
            </div>

            <!-- Completion Section -->
            @if (Model.Completion != null)
            {
                <div class="card p-4 mb-4 border-success" style="border-left:4px solid var(--success)!important;">
                    <h5 class="fw-bold mb-1 text-success"><i class="bi bi-trophy-fill me-2"></i>Campaign Completed!</h5>
                    <p class="text-muted small mb-3">
                        Reported on @Model.Completion.CreatedAt.ToString("MMM d, yyyy") by @Model.Completion.CreatedByName
                    </p>
                    <p style="white-space:pre-line;">@Model.Completion.Caption</p>
                    @if (Model.Completion.Images.Count > 0)
                    {
                        <div class="row g-2 mt-2">
                            @foreach (var img in Model.Completion.Images)
                            {
                                <div class="col-4 col-md-3">
                                    <img src="@img.ImageUrl" class="gallery-thumb w-100"
                                         alt="@img.Caption"
                                         onclick="openLightbox('@img.ImageUrl')" />
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Progress Card -->
            <div class="card p-4 mb-3">
                <div class="campaign-amount">@Model.RaisedAmount.ToString("N0") MMK</div>
                <div class="campaign-goal mb-3">raised of @Model.GoalAmount.ToString("N0") MMK goal</div>
                <div class="progress mb-2">
                    <div class="progress-bar @(Model.ProgressPercent >= 100 ? "goal-reached" : "")"
                         style="width:@Model.ProgressPercent%"></div>
                </div>
                <div class="d-flex justify-content-between text-muted small mb-4">
                    <span>@Model.ProgressPercent% funded</span>
                </div>

                @if (Model.CanDonate && Model.Status == "OPEN")
                {
                    <a asp-controller="Donation" asp-action="Submit" asp-route-id="@Model.Id"
                       class="btn btn-primary w-100 btn-lg">
                        <i class="bi bi-heart-fill me-2 text-danger"></i>Donate Now
                    </a>
                }
                else if (Model.Status == "OPEN" && !User.Identity!.IsAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 btn-lg">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login to Donate
                    </a>
                }
                else if (Model.Status == "OPEN" && Model.IsOwner)
                {
                    <div class="alert alert-info border-0 mb-0 text-center small">
                        <i class="bi bi-info-circle me-1"></i>You cannot donate to your own campaign.
                    </div>
                }
                else if (Model.Status == "GOAL_REACHED" || Model.Status == "CLOSED" || Model.Status == "COMPLETED")
                {
                    <div class="alert alert-success border-0 mb-0 text-center">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @(Model.Status == "COMPLETED" ? "Campaign Completed!" : "Goal Reached!")
                    </div>
                }
            </div>

            <!-- Owner Actions (Only for PENDING campaigns) -->
            @if (Model.IsOwner && Model.Status == "PENDING")
            {
                <div class="card p-3 mb-3">
                    <h6 class="fw-bold mb-2"><i class="bi bi-gear me-1"></i>Campaign Actions</h6>
                    <div class="d-grid gap-2">
                        <a asp-controller="Campaign" asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil me-1"></i>Edit Campaign
                        </a>
                        <button class="btn btn-outline-danger btn-sm" id="deleteCampaignBtn"
                                data-id="@Model.Id">
                            <i class="bi bi-trash me-1"></i>Delete Campaign
                        </button>
                    </div>
                </div>
            }

            <!-- Admin Actions -->
            @if (User.IsInRole("ADMIN"))
            {
                <div class="card p-3 mb-3 border-warning">
                    <h6 class="fw-bold mb-2 text-warning"><i class="bi bi-shield-check me-1"></i>Admin Actions</h6>
                    <a asp-controller="Admin" asp-action="CampaignDetail" asp-route-id="@Model.Id"
                       class="btn btn-outline-warning btn-sm w-100">
                        <i class="bi bi-eye me-1"></i>View in Admin Panel
                    </a>
                </div>
            }

            <!-- Campaign Info -->
            <div class="card p-3 mb-3">
                <h6 class="fw-bold mb-2"><i class="bi bi-info-circle me-1 text-primary"></i>Campaign Info</h6>
                <ul class="list-unstyled small mb-0">
                    @if (!string.IsNullOrEmpty(Model.Township))
                    {
                        <li class="mb-2">
                            <i class="bi bi-geo-alt me-1 text-muted"></i>
                            <span class="text-muted">Township:</span>
                            <span class="fw-medium ms-1">@Model.Township</span>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <li class="mb-2">
                            <i class="bi bi-pin-map me-1 text-muted"></i>
                            <span class="text-muted">Address:</span>
                            <span class="fw-medium ms-1">@Model.Address</span>
                        </li>
                    }
                    <li class="mb-1"><span class="text-muted">Created:</span> <span class="fw-medium">@Model.CreatedAt.ToString("MMM d, yyyy")</span></li>
                    @if (Model.ClosedAt.HasValue)
                    {
                        <li class="mb-1"><span class="text-muted">Closed:</span> <span class="fw-medium">@Model.ClosedAt.Value.ToString("MMM d, yyyy")</span></li>
                    }
                    @if (Model.CompletedAt.HasValue)
                    {
                        <li class="mb-1"><span class="text-muted">Completed:</span> <span class="fw-medium text-success">@Model.CompletedAt.Value.ToString("MMM d, yyyy")</span></li>
                    }
                </ul>
            </div>

            <!-- Organizer link -->
            <div class="card p-3">
                <h6 class="fw-bold mb-2"><i class="bi bi-person me-1 text-primary"></i>Organizer</h6>
                <a href="@Url.Action("Public", "Profile", new { id = Model.OwnerId })"
                   class="d-flex align-items-center gap-2 text-decoration-none">
                    @if (!string.IsNullOrEmpty(Model.OwnerProfileImage))
                    {
                        <img src="@Model.OwnerProfileImage" class="rounded-circle" width="40" height="40" style="object-fit:cover;" alt="" />
                    }
                    else
                    {
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                              style="width:40px;height:40px;min-width:40px;background:linear-gradient(135deg,#5c6bc0,#ff7043);">
                            <i class="bi bi-person-fill text-white"></i>
                        </span>
                    }
                    <div>
                        <div class="fw-semibold text-dark small">@Model.OwnerName</div>
                        <div class="text-muted" style="font-size:.78rem;">@@@Model.OwnerUsername</div>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted small"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox Modal -->
<div class="modal fade" id="lightboxModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body p-0 text-center">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3"
                        data-bs-dismiss="modal"></button>
                <img id="lightboxImg" src="" class="img-fluid rounded-xl" alt="" style="max-height:85vh;object-fit:contain;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchImage(url) {
            $('#mainImage').attr('src', url);
        }

        function openLightbox(url) {
            $('#lightboxImg').attr('src', url);
            new bootstrap.Modal(document.getElementById('lightboxModal')).show();
        }

        @if (Model.IsOwner && Model.Status == "PENDING")
        {
            <text>
            $('#deleteCampaignBtn').on('click', function () {
                var id = $(this).data('id');
                Danation.confirmPost(
                    'Are you sure you want to delete this campaign? This action cannot be undone.',
                    '/Campaign/Delete/' + id, {},
                    function () {
                        Notiflix.Notify.success('Campaign deleted.');
                        setTimeout(function () { window.location.href = '/Campaign/My'; }, 1000);
                    }
                );
            });
            </text>
        }
    </script>
}
