@model MyCampaignsViewModel
@{
    ViewData["Title"] = "ကျွန်ုပ်၏ Campaign များ — Danation";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="mb-1"><i class="bi bi-megaphone me-2"></i>ကျွန်ုပ်၏ Campaign များ</h1>
                <p class="mb-0 opacity-75">ဖန်တီးထားသော Campaign @Model.Campaigns.Count ခု</p>
            </div>
            <div class="col-auto">
                <a asp-controller="Campaign" asp-action="Create" class="btn btn-warning fw-bold">
                    <i class="bi bi-plus-circle me-2"></i>Campaign အသစ်
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    @if (Model.Campaigns.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-megaphone"></i>
            <h4>Campaign မရှိသေးပါ</h4>
            <p>သင်၏ ပထမဆုံး Campaign ကို ယနေ့ စတင်လိုက်ပါ!</p>
            <a asp-controller="Campaign" asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Campaign ဖန်တီးမည်
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model.Campaigns)
            {
                var statusClass = c.Status switch
                {
                    "OPEN" => "badge-open",
                    "GOAL_REACHED" => "badge-goal",
                    "CLOSED" => "badge-closed",
                    "COMPLETED" => "badge-completed",
                    "REJECTED" => "badge-rejected",
                    _ => "badge-pending"
                };
                var statusText = c.Status switch
                {
                    "OPEN" => "ဖွင့်လှစ်နေသည်",
                    "GOAL_REACHED" => "ပန်းတိုင် ရောက်ပြီ",
                    "CLOSED" => "ပိတ်သိမ်းပြီး",
                    "COMPLETED" => "ပြီးမြောက်ပြီး",
                    "REJECTED" => "ငြင်းပယ်ခံရသည်",
                    _ => "အတည်ပြုချက်စောင့်ဆိုင်းဆဲ"
                };
                <div class="col-md-6 col-lg-4 my-campaign-col" data-campaign-id="@c.Id">
                    <div class="card campaign-card h-100 shadow-sm border-0">
                        <a href="@Url.Action("Detail", "Campaign", new { id = c.Id })" class="text-decoration-none">
                            @if (!string.IsNullOrEmpty(c.ThumbnailImage))
                            {
                                <img src="@c.ThumbnailImage" class="card-img-top" alt="@c.Title" style="height:180px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="campaign-card card-img-placeholder" style="height:180px;">
                                    <i class="bi bi-heart-fill text-success" style="font-size:2.5rem;opacity:.4;"></i>
                                </div>
                            }
                        </a>
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @statusClass my-campaign-status">@statusText</span>
                                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@c.CreatedAt.ToString("MMM d")</span>
                            </div>
                            <h5 class="card-title fw-bold">
                                <a href="@Url.Action("Detail", "Campaign", new { id = c.Id })" class="text-dark text-decoration-none">@c.Title</a>
                            </h5>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold text-success">@c.RaisedAmount.ToString("N0") MMK</span>
                                    <span class="text-muted">@c.ProgressPercent%</span>
                                </div>
                                <div class="progress mb-1">
                                    <div class="progress-bar @(c.ProgressPercent >= 100 ? "goal-reached" : "")"
                                         style="width:@c.ProgressPercent%"></div>
                                </div>
                                <div class="text-muted small">ပန်းတိုင်: @c.GoalAmount.ToString("N0") MMK</div>
                            </div>
                            <!-- Action Buttons -->
                            <div class="d-flex gap-2 mt-3 pt-3 border-top my-campaign-actions">
                                <a asp-controller="Campaign" asp-action="Detail" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-outline-primary flex-grow-1">
                                    <i class="bi bi-eye me-1"></i>ကြည့်မည်
                                </a>
                                @if (c.Status == "PENDING")
                                {
                                    <a asp-controller="Campaign" asp-action="Edit" asp-route-id="@c.Id"
                                       class="btn btn-sm btn-outline-secondary flex-grow-1">
                                        <i class="bi bi-pencil me-1"></i>ပြင်ဆင်မည်
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger delete-btn" data-id="@c.Id" title="ဖျက်မည်">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).on('click', '.delete-btn', function () {
            var id = $(this).data('id');
            var card = $(this).closest('.col-md-6, .col-lg-4');
            Danation.confirmPost(
                'ဤ Campaign ကို ပယ်ဖျက်ရန် သေချာပါသလား?',
                '/Campaign/Delete/' + id, {},
                function (res) {
                    Notiflix.Notify.success(res.message);
                    card.fadeOut(400, function () { $(this).remove(); });
                }
            );
        });

        // Real-time: Update status and lock actions when admin approves/rejects
        $(document).on('campaignStatusChanged', function (e, data) {
            var col = $('.my-campaign-col[data-campaign-id="' + data.campaignId + '"]');
            if (col.length) {
                var badgeMap = {
                    'OPEN': 'badge-open',
                    'GOAL_REACHED': 'badge-goal',
                    'CLOSED': 'badge-closed',
                    'COMPLETED': 'badge-completed',
                    'REJECTED': 'badge-rejected',
                    'PENDING': 'badge-pending'
                };
                var textMap = {
                    'OPEN': 'ဖွင့်လှစ်နေသည်',
                    'GOAL_REACHED': 'ပန်းတိုင် ရောက်ပြီ',
                    'CLOSED': 'ပိတ်သိမ်းပြီး',
                    'COMPLETED': 'ပြီးမြောက်ပြီး',
                    'REJECTED': 'ငြင်းပယ်ခံရသည်',
                    'PENDING': 'အတည်ပြုချက်စောင့်ဆိုင်းဆဲ'
                };
                var cls = badgeMap[data.status] || 'bg-secondary';
                var text = textMap[data.status] || data.status.replace('_', ' ');
                if (data.status === 'CLOSED') {
                    if (data.closeReason === 'EXPIRED') {
                        text = 'သက်တမ်းကုန်ပြီ';
                        cls = 'badge-closed';
                    } else if (data.closeReason === 'GOAL_REACHED') {
                        text = 'ပန်းတိုင် ရောက်ပြီ';
                        cls = 'badge-goal';
                    }
                }
                col.find('.my-campaign-status').attr('class', 'badge ' + cls + ' my-campaign-status').text(text);

                if (data.status !== 'PENDING') {
                    col.find('.my-campaign-actions').html(
                        '<a href="/Campaign/Detail/' + data.campaignId + '" class="btn btn-sm btn-outline-primary flex-grow-1"><i class="bi bi-eye me-1"></i>ကြည့်မည်</a>'
                    );
                }
            }
        });

        $(document).on('campaignDonationUpdated', function (e, data) {
            var col = $('.my-campaign-col[data-campaign-id="' + data.campaignId + '"]');
            if (col.length) {
                col.find('.fw-semibold').first().text(Danation.formatMMK(data.raisedAmount));
                col.find('.progress-bar')
                    .css('width', data.progressPercent + '%')
                    .toggleClass('goal-reached', data.progressPercent >= 100);
            }
        });
    </script>
}
