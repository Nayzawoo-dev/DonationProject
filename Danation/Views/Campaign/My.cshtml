@model MyCampaignsViewModel
@{
    ViewData["Title"] = "My Campaigns";
    Layout = "_Layout";
}

<div class="admin-page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="mb-1"><i class="bi bi-megaphone me-2"></i>My Campaigns</h1>
                <p class="mb-0 opacity-75">@Model.Campaigns.Count campaign@(Model.Campaigns.Count != 1 ? "s" : "") created</p>
            </div>
            <div class="col-auto">
                <a asp-controller="Campaign" asp-action="Create" class="btn btn-warning fw-bold">
                    <i class="bi bi-plus-circle me-2"></i>New Campaign
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    @if (Model.Campaigns.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-megaphone"></i>
            <h4>No Campaigns Yet</h4>
            <p>Start your first fundraising campaign today!</p>
            <a asp-controller="Campaign" asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Create Campaign
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model.Campaigns)
            {
                var statusClass = c.Status switch
                {
                    "OPEN" => "badge-open",
                    "GOAL_REACHED" => "badge-goal",
                    "CLOSED" => "badge-closed",
                    "COMPLETED" => "badge-completed",
                    "REJECTED" => "badge-rejected",
                    _ => "badge-pending"
                };
                <div class="col-md-6 col-lg-4">
                    <div class="card campaign-card h-100">
                        <a href="@Url.Action("Detail", "Campaign", new { id = c.Id })" class="text-decoration-none">
                            @if (!string.IsNullOrEmpty(c.ThumbnailImage))
                            {
                                <img src="@c.ThumbnailImage" class="card-img-top" alt="@c.Title" style="height:180px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="campaign-card card-img-placeholder" style="height:180px;">
                                    <i class="bi bi-heart-fill text-primary" style="font-size:2.5rem;opacity:.4;"></i>
                                </div>
                            }
                        </a>
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @statusClass">@c.Status.Replace("_", " ")</span>
                                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@c.CreatedAt.ToString("MMM d")</span>
                            </div>
                            <h5 class="card-title fw-bold">
                                <a href="@Url.Action("Detail", "Campaign", new { id = c.Id })" class="text-dark text-decoration-none">@c.Title</a>
                            </h5>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold">@c.RaisedAmount.ToString("N0") MMK</span>
                                    <span class="text-muted">@c.ProgressPercent%</span>
                                </div>
                                <div class="progress mb-1">
                                    <div class="progress-bar @(c.ProgressPercent >= 100 ? "goal-reached" : "")"
                                         style="width:@c.ProgressPercent%"></div>
                                </div>
                                <div class="text-muted small">Goal: @c.GoalAmount.ToString("N0") MMK</div>
                            </div>
                            <!-- Action Buttons -->
                            <div class="d-flex gap-2 mt-3 pt-3 border-top">
                                <a asp-controller="Campaign" asp-action="Detail" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-outline-primary flex-grow-1">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                                @if (c.Status == "PENDING" || c.Status == "OPEN")
                                {
                                    <a asp-controller="Campaign" asp-action="Edit" asp-route-id="@c.Id"
                                       class="btn btn-sm btn-outline-secondary flex-grow-1">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                }
                                @if (c.Status == "PENDING")
                                {
                                    <button class="btn btn-sm btn-outline-danger delete-btn" data-id="@c.Id" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).on('click', '.delete-btn', function () {
            var id = $(this).data('id');
            var card = $(this).closest('.col-md-6, .col-lg-4');
            Danation.confirmPost(
                'Are you sure you want to delete this campaign?',
                '/Campaign/Delete/' + id, {},
                function (res) {
                    Notiflix.Notify.success(res.message);
                    card.fadeOut(400, function () { $(this).remove(); });
                }
            );
        });
    </script>
}
