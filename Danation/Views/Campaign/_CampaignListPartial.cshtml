@model CampaignListViewModel

<!-- Hidden field to update header count dynamically -->
<input type="hidden" id="partialTotalCount" value="@Model.TotalCount" />

<!-- Active Filters -->
@if (!string.IsNullOrEmpty(Model.TownshipFilter) || !string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter))
{
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
        <small class="text-muted">Active filters:</small>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <span class="badge bg-primary-light text-primary px-3 py-2 d-inline-flex align-items-center gap-1" style="border-radius:50px;font-size:.8rem;">
                <i class="bi bi-search me-1"></i>@Model.SearchTerm
                <button type="button" class="btn-close btn-close-sm ms-1 clear-filter-btn" data-filter="search" style="font-size:8px;"></button>
            </span>
        }
        @if (!string.IsNullOrEmpty(Model.TownshipFilter))
        {
            <span class="badge bg-primary-light text-primary px-3 py-2 d-inline-flex align-items-center gap-1" style="border-radius:50px;font-size:.8rem;">
                <i class="bi bi-geo-alt me-1"></i>@Model.TownshipFilter
                <button type="button" class="btn-close btn-close-sm ms-1 clear-filter-btn" data-filter="township" style="font-size:8px;"></button>
            </span>
        }
        @if (!string.IsNullOrEmpty(Model.StatusFilter))
        {
            <span class="badge bg-primary-light text-primary px-3 py-2 d-inline-flex align-items-center gap-1" style="border-radius:50px;font-size:.8rem;">
                <i class="bi bi-funnel me-1"></i>@Model.StatusFilter.Replace("_"," ")
                <button type="button" class="btn-close btn-close-sm ms-1 clear-filter-btn" data-filter="status" style="font-size:8px;"></button>
            </span>
        }
        <button type="button" class="btn btn-link btn-sm text-muted text-decoration-none py-0 clear-all-filters-btn">
            Clear all
        </button>
    </div>
}

<!-- Campaign Grid -->
@if (Model.Campaigns.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-megaphone"></i>
        <h4>No Campaigns Found</h4>
        <p>Try adjusting your search filters or check back later.</p>
        <button type="button" class="btn btn-outline-primary mt-2 clear-all-filters-btn">Clear All Filters</button>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var c in Model.Campaigns)
        {
            <div class="col-md-6 col-lg-4">
                <a href="@Url.Action("Detail", "Campaign", new { id = c.Id })" class="text-decoration-none">
                    <div class="card campaign-card h-100" data-campaign-id="@c.Id">
                        @if (!string.IsNullOrEmpty(c.ThumbnailImage))
                        {
                            <img src="@c.ThumbnailImage" class="card-img-top" alt="@c.Title" style="height:200px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="campaign-card card-img-placeholder">
                                <i class="bi bi-heart-fill text-primary" style="font-size:3rem;opacity:.4;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge badge-@c.Status.ToLower().Replace("_", "-") campaign-card-status">@c.Status.Replace("_", " ")</span>
                                @if (c.ImageCount > 0)
                                {
                                    <span class="text-muted small"><i class="bi bi-images me-1"></i>@c.ImageCount</span>
                                }
                            </div>
                            <h5 class="card-title fw-bold text-dark">@c.Title</h5>
                            @if (!string.IsNullOrEmpty(c.Township))
                            {
                                <p class="small text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>@c.Township</p>
                            }
                            <p class="card-text text-muted flex-grow-1">
                                @(c.Description.Length > 100 ? c.Description[..100] + "…" : c.Description)
                            </p>
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold campaign-card-raised">@c.RaisedAmount.ToString("N0") MMK raised</span>
                                    <span class="text-muted campaign-card-percent">@c.ProgressPercent%</span>
                                </div>
                                <div class="progress">
                                    <div class="progress-bar campaign-card-bar @(c.ProgressPercent >= 100 ? "goal-reached" : "")"
                                         style="width:@c.ProgressPercent%"></div>
                                </div>
                                <div class="text-muted small mt-1">Goal: @c.GoalAmount.ToString("N0") MMK</div>
                            </div>
                            <div class="d-flex align-items-center mt-3 pt-3 border-top">
                                @if (!string.IsNullOrEmpty(c.OwnerProfileImage))
                                {
                                    <img src="@c.OwnerProfileImage" class="rounded-circle me-2" width="26" height="26" style="object-fit:cover;" alt="" />
                                }
                                else
                                {
                                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center me-2"
                                          style="width:26px;height:26px;background:linear-gradient(135deg,#5c6bc0,#ff7043);">
                                        <i class="bi bi-person-fill text-white" style="font-size:12px;"></i>
                                    </span>
                                }
                                <span class="text-muted small">@c.OwnerName</span>
                                <span class="text-muted small ms-auto"><i class="bi bi-calendar3 me-1"></i>@c.CreatedAt.ToString("MMM d")</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-5 d-flex justify-content-center" aria-label="Campaign pages">
            <ul class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link campaign-page-link" href="#" data-page="@(Model.CurrentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                }
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link campaign-page-link" href="#" data-page="@i">@i</a>
                    </li>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link campaign-page-link" href="#" data-page="@(Model.CurrentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
