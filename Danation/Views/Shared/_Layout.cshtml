<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Danation — A professional charity and donation management platform connecting donors with meaningful causes." />
    <title>@ViewData["Title"] - Danation</title>

    <!-- Bootstrap 5.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- DataTables Bootstrap5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <!-- Notiflix CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notiflix@3.2.6/dist/notiflix-3.2.6.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Top Navigation -->
    <nav class="navbar navbar-expand-lg sticky-top" id="mainNavbar">
        <div class="container">
            <!-- Brand -->
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-heart-fill me-2 text-danger"></i>Donation Charity
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <!-- Left Nav Links -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Campaign" asp-action="Index">
                            <i class="bi bi-grid-3x3-gap me-1"></i>Campaigns
                        </a>
                    </li>
                </ul>

                <!-- Right Nav -->
                <ul class="navbar-nav align-items-center gap-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Notifications Bell -->
                        <li class="nav-item dropdown">
                            <a class="nav-link position-relative px-2" href="#" id="notifDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="bi bi-bell fs-5"></i>
                                <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                    0
                                </span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0" id="notifDropdownMenu" style="width: 360px; max-height: 480px;">
                                <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-light rounded-top">
                                    <h6 class="mb-0 fw-semibold">Notifications</h6>
                                    <a href="#" id="markAllReadBtn" class="text-muted small text-decoration-none">Mark all read</a>
                                </div>
                                <div id="notifList" style="overflow-y: auto; max-height: 380px;">
                                    <div class="text-center text-muted py-4 small" id="notifEmpty">
                                        <i class="bi bi-bell-slash fs-3 d-block mb-2"></i>No notifications
                                    </div>
                                </div>
                                <div class="px-3 py-2 border-top text-center">
                                    <a asp-controller="Notification" asp-action="Index" class="text-decoration-none small fw-semibold">View all notifications</a>
                                </div>
                            </div>
                        </li>

                        <!-- User Menu -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 ps-2" href="#" data-bs-toggle="dropdown">
                                @{
                                    var profileImg = User.FindFirst("ProfileImage")?.Value;
                                    var fullName = User.Identity?.Name ?? "User";
                                }
                                @if (!string.IsNullOrEmpty(profileImg))
                                {
                                    <img src="@profileImg" class="rounded-circle" width="30" height="30" style="object-fit:cover;" alt="Profile" />
                                }
                                else
                                {
                                    <span class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center" style="width:30px;height:30px;">
                                        <i class="bi bi-person-fill text-white small"></i>
                                    </span>
                                }
                                <span class="d-none d-lg-inline fw-medium">@fullName.Split(' ')[0]</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                @if (User.IsInRole("ADMIN"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2 text-primary"></i>Admin Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Campaigns"><i class="bi bi-megaphone me-2 text-primary"></i>Manage Campaigns</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Donations"><i class="bi bi-cash-stack me-2 text-primary"></i>Manage Donations</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2 text-primary"></i>Manage Users</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-controller="Campaign" asp-action="My"><i class="bi bi-megaphone me-2 text-success"></i>My Campaigns</a></li>
                                    <li><a class="dropdown-item" asp-controller="Donation" asp-action="My"><i class="bi bi-heart me-2 text-danger"></i>My Donations</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="fw-bold"><i class="bi bi-heart-fill text-danger me-1"></i>Donation Charity</span>
                    <span class="text-white-50 ms-2 small">— Making a difference together</span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="text-white-50 small">&copy; 2026 Donation Charity</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Hidden CSRF token for AJAX -->
    @Html.AntiForgeryToken()

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <!-- Notiflix JS -->
    <script src="https://cdn.jsdelivr.net/npm/notiflix@3.2.6/dist/notiflix-3.2.6.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            // Notification polling
            (function () {
                function loadNotifications() {
                    $.get('/Notification/UnreadCount', function (data) {
                        var count = data.count || 0;
                        if (count > 0) {
                            $('#notifBadge').text(count > 99 ? '99+' : count).removeClass('d-none');
                        } else {
                            $('#notifBadge').addClass('d-none');
                        }
                    });
                }
                loadNotifications();
                setInterval(loadNotifications, 60000);

                // Load latest notifications on dropdown open
                $('#notifDropdown').on('show.bs.dropdown', function () {
                    $.get('/Notification/Latest', function (res) {
                        if (!res.success || !res.data || res.data.length === 0) {
                            $('#notifEmpty').show();
                            $('#notifList').find('.notif-item').remove();
                            return;
                        }
                        $('#notifEmpty').hide();
                        var html = '';
                        $.each(res.data, function (i, n) {
                            html += '<div class="notif-item px-3 py-2 border-bottom ' + (!n.isRead ? 'bg-light-blue' : '') + '" data-id="' + n.id + '">' +
                                '<div class="d-flex justify-content-between align-items-start">' +
                                '<strong class="small">' + $('<span>').text(n.title).html() + '</strong>' +
                                '<span class="text-muted" style="font-size:11px;white-space:nowrap;margin-left:8px;">' + n.relativeTime + '</span>' +
                                '</div>' +
                                '<p class="mb-0 small text-muted mt-1">' + $('<span>').text(n.message).html() + '</p>' +
                                '</div>';
                        });
                        $('#notifList').find('.notif-item').remove();
                        $('#notifList').prepend(html);
                    });
                });

                // Mark all read
                $('#markAllReadBtn').on('click', function (e) {
                    e.preventDefault();
                    $.post('/Notification/MarkAllRead', { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function () {
                        $('#notifBadge').addClass('d-none');
                        $('#notifList .notif-item').removeClass('bg-light-blue');
                        Notiflix.Notify.success('All notifications marked as read.');
                    });
                });
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
